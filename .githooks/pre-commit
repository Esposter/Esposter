#!/bin/sh
# Each staged entry is recorded before formatting, under the committing git process's id, so the post-commit hook can
# tell the unformatted copy a commit by pathspec leaves in the real index from an entry another session staged
set -e
export GIT_LITERAL_PATHSPECS=1
STAGED_FILE=$(mktemp)
trap 'rm -f "$STAGED_FILE"' EXIT
git diff --cached --name-only --diff-filter=ACMR -z > "$STAGED_FILE"
[ -s "$STAGED_FILE" ] || exit 0
xargs -0 git ls-files -s -- < "$STAGED_FILE" > "$(git rev-parse --git-path "pre-commit-entries-$PPID")"
xargs -0 -n 50 ./node_modules/.bin/oxfmt --no-error-on-unmatched-pattern < "$STAGED_FILE" || true
xargs -0 -n 50 git add < "$STAGED_FILE"
