+    static void Fingerprint(ReadOnlySpan<byte> compressed, ReadOnlySpan<byte> decompressed, int numWrite)
+    {
+        lock (fingerprintLock)
+        {
+            var chunkDirectory = fingerprintPath + ".chunks";
+            if (fingerprintCallCount == 0)
+            {
+                File.WriteAllText(fingerprintPath!, string.Empty);
+                if (Directory.Exists(chunkDirectory))
+                    Directory.Delete(chunkDirectory, true);
+                Directory.CreateDirectory(chunkDirectory);
+            }
+
+            var index = fingerprintCallCount++;
+            var output = decompressed[..Math.Max(numWrite, 0)];
+            var chunks = new StringBuilder();
+            for (var offset = 0; offset < output.Length; offset += FINGERPRINT_CHUNK_SIZE)
+                chunks.Append(Sha256(output.Slice(offset, Math.Min(FINGERPRINT_CHUNK_SIZE, output.Length - offset)))).Append('\n');
+            File.WriteAllText(Path.Combine(chunkDirectory, $"{index:D6}.txt"), chunks.ToString());
+
+            var chunkCount = (output.Length + FINGERPRINT_CHUNK_SIZE - 1) / FINGERPRINT_CHUNK_SIZE;
+            File.AppendAllText(fingerprintPath!, $"{index}\t{compressed.Length}\t{decompressed.Length}\t{numWrite}\t{Sha256(compressed)}\t{Sha256(output)}\t{chunkCount}\n");
+        }
+    }
+
+    static string Sha256(ReadOnlySpan<byte> bytes) => Convert.ToHexString(SHA256.HashData(bytes)).ToLowerInvariant();
