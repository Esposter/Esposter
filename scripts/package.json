{
  "name": "@esposter/scripts",
  "version": "3.0.0",
  "private": true,
  "description": "The repository's own tooling: the workspace dependency graph, the outdated-dependency report, the custom oxlint plugins, the sweep scans and the cross-platform launcher.",
  "keywords": [
    "cli",
    "dependency-graph",
    "graphviz",
    "linting",
    "monorepo",
    "oxlint",
    "pnpm",
    "tooling",
    "ts",
    "typescript",
    "workspace"
  ],
  "homepage": "https://github.com/Esposter/Esposter/blob/main/scripts#readme",
  "bugs": {
    "url": "https://github.com/Esposter/Esposter/issues"
  },
  "license": "Apache-2.0",
  "author": "Jimmy Chen",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Esposter/Esposter.git"
  },
  "type": "module",
  "imports": {
    "#src/*": "./src/*.ts"
  },
  "scripts": {
    "ai:coderabbit:collect": "tsx src/coderabbit/collect/index.ts",
    "ai:coderabbit:exclusions": "tsx src/coderabbit/exclusions/index.ts",
    "ai:coderabbit:feedback": "tsx src/coderabbit/feedback/index.ts",
    "ai:coderabbit:probe": "tsx src/coderabbit/probe/index.ts",
    "ai:coderabbit:window": "tsx src/coderabbit/window/index.ts",
    "ai:sweep:constant-scope": "tsx src/sweeps/constantScope/index.ts",
    "ai:sweep:repeated-list-items": "tsx src/sweeps/repeatedListItems/index.ts",
    "ai:sweep:shared-export-consumers": "tsx src/sweeps/sharedExportConsumers/index.ts",
    "ai:sweep:skill-docs": "tsx src/sweeps/skillDocs/index.ts",
    "ai:sweep:unterminated-results": "tsx src/sweeps/unterminatedResults/index.ts",
    "bench": "vitest bench --run",
    "crossOS": "tsx src/crossOS/index.ts",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "graph:gen": "tsx src/dependencyGraph/index.ts",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "outdated:dependencies": "tsx src/outdatedDependencies/index.ts",
    "test": "vitest",
    "typecheck": "tsc",
    "update:node": "tsx src/updateNode/index.ts"
  },
  "devDependencies": {
    "@esposter/configuration": "workspace:*",
    "@esposter/shared": "workspace:*",
    "@esposter/shared-node": "workspace:*",
    "@hpcc-js/wasm-graphviz": "catalog:",
    "@oxlint/plugins": "catalog:",
    "@types/node": "catalog:",
    "tsx": "catalog:",
    "vitest": "catalog:"
  }
}
