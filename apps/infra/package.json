{
  "name": "@esposter/infra",
  "version": "2.39.0",
  "private": true,
  "description": "Pulumi infrastructure code for Esposter Azure resources.",
  "keywords": [
    "azure",
    "azure-native",
    "cloud",
    "deployment",
    "devops",
    "iac",
    "infrastructure",
    "pulumi",
    "ts",
    "typescript"
  ],
  "homepage": "https://github.com/Esposter/Esposter/blob/main/packages/infra#readme",
  "bugs": {
    "url": "https://github.com/Esposter/Esposter/issues"
  },
  "license": "Apache-2.0",
  "author": "Jimmy Chen",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Esposter/Esposter.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "dist/index.d.ts",
  "imports": {
    "#src/*": "./src/*.ts"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.js",
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "tsdown",
    "export:gen": "generate-exports",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "infra:preview": "pnpm build && pulumi preview",
    "infra:refresh": "pnpm build && pulumi refresh",
    "infra:up": "pnpm build && pulumi up",
    "test": "vitest",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@esposter/db-schema": "workspace:*"
  },
  "devDependencies": {
    "@esposter/configuration": "workspace:*",
    "@types/node": "catalog:",
    "tsdown": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@pulumi/azure-native": "catalog:",
    "@pulumi/github": "catalog:",
    "@pulumi/pulumi": "catalog:"
  }
}
