{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "main": "src/worker.ts",
  "account_id": "33d16cc4281c2845398ddb2fbd29829b",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "rules": [{ "type": "Text", "globs": ["**/*.sql"], "fallthrough": true }],
  "env": {
    "prod": {
      "name": "prod-wkr-esposter-functions",
      "vars": { "BASE_URL": "https://esposter.com", "CLOUDFLARE_ENVIRONMENT": "prod" },
      "triggers": { "crons": ["0 3 * * *"] },
      "queues": {
        "producers": [
          { "binding": "DELETE_ACCOUNT_QUEUE", "queue": "prod-q-esposter-delete-account" },
          {
            "binding": "DELETE_ORPHANED_PROFILE_IMAGE_QUEUE",
            "queue": "prod-q-esposter-delete-orphaned-profile-image",
          },
          { "binding": "EXPORT_USER_DATA_QUEUE", "queue": "prod-q-esposter-export-user-data" },
          { "binding": "PROCESS_BLOB_DELETION_QUEUE", "queue": "prod-q-esposter-process-blob-deletion" },
          { "binding": "PROCESS_NOTIFICATION_QUEUE", "queue": "prod-q-esposter-process-notification" },
          {
            "binding": "PROCESS_SCHEDULED_MESSAGE_JOB_QUEUE",
            "queue": "prod-q-esposter-process-scheduled-message-job",
          },
          { "binding": "PROCESS_WEBHOOK_QUEUE", "queue": "prod-q-esposter-process-webhook" },
          {
            "binding": "RECONCILE_STORAGE_LEDGER_ENTRY_QUEUE",
            "queue": "prod-q-esposter-reconcile-storage-ledger-entry",
          },
        ],
      },
      "d1_databases": [
        {
          "binding": "CORE",
          "database_name": "prod-d1-esposter-core",
          "database_id": "08a5061a-0fbb-487e-883e-f6b660cffce2",
        },
      ],
      "r2_buckets": [
        { "binding": "CLICKER_ASSETS", "bucket_name": "prod-r2-esposter-clicker-assets" },
        { "binding": "GENSHIN_ASSETS", "bucket_name": "prod-r2-esposter-genshin-assets" },
        { "binding": "MESSAGE_ASSETS", "bucket_name": "prod-r2-esposter-message-assets" },
        { "binding": "PUBLIC_APP_ASSETS", "bucket_name": "prod-r2-esposter-public-app-assets" },
        { "binding": "PUBLIC_DUNGEONS_ASSETS", "bucket_name": "prod-r2-esposter-public-dungeons-assets" },
        { "binding": "PUBLIC_GENSHIN_ASSETS", "bucket_name": "prod-r2-esposter-public-genshin-assets" },
        { "binding": "PUBLIC_USER_ASSETS", "bucket_name": "prod-r2-esposter-public-user-assets" },
        { "binding": "RESOURCE_ASSETS", "bucket_name": "prod-r2-esposter-resource-assets" },
        { "binding": "USER_ASSETS", "bucket_name": "prod-r2-esposter-user-assets" },
      ],
      "durable_objects": {
        "bindings": [
          { "name": "SCHEDULER", "class_name": "Scheduler" },
          { "name": "CALL", "class_name": "CallObject" },
          { "name": "ROOM", "class_name": "RoomObject" },
          { "name": "USER", "class_name": "UserObject" },
        ],
      },
      "migrations": [
        { "tag": "v1", "new_sqlite_classes": ["Scheduler"] },
        { "tag": "v2", "new_sqlite_classes": ["CallObject", "RoomObject", "UserObject"] },
      ],
    },
    "dev": {
      "name": "dev-wkr-esposter-functions",
      "vars": { "BASE_URL": "https://dev.esposter.com", "CLOUDFLARE_ENVIRONMENT": "dev" },
      "triggers": { "crons": ["0 3 * * *"] },
      "queues": {
        "producers": [
          { "binding": "DELETE_ACCOUNT_QUEUE", "queue": "dev-q-esposter-delete-account" },
          { "binding": "DELETE_ORPHANED_PROFILE_IMAGE_QUEUE", "queue": "dev-q-esposter-delete-orphaned-profile-image" },
          { "binding": "EXPORT_USER_DATA_QUEUE", "queue": "dev-q-esposter-export-user-data" },
          { "binding": "PROCESS_BLOB_DELETION_QUEUE", "queue": "dev-q-esposter-process-blob-deletion" },
          { "binding": "PROCESS_NOTIFICATION_QUEUE", "queue": "dev-q-esposter-process-notification" },
          { "binding": "PROCESS_SCHEDULED_MESSAGE_JOB_QUEUE", "queue": "dev-q-esposter-process-scheduled-message-job" },
          { "binding": "PROCESS_WEBHOOK_QUEUE", "queue": "dev-q-esposter-process-webhook" },
          {
            "binding": "RECONCILE_STORAGE_LEDGER_ENTRY_QUEUE",
            "queue": "dev-q-esposter-reconcile-storage-ledger-entry",
          },
        ],
      },
      "d1_databases": [
        {
          "binding": "CORE",
          "database_name": "dev-d1-esposter-core",
          "database_id": "0973f2df-a1f0-4d43-a801-663b0698503b",
        },
      ],
      "r2_buckets": [
        { "binding": "CLICKER_ASSETS", "bucket_name": "dev-r2-esposter-clicker-assets" },
        { "binding": "GENSHIN_ASSETS", "bucket_name": "dev-r2-esposter-genshin-assets" },
        { "binding": "MESSAGE_ASSETS", "bucket_name": "dev-r2-esposter-message-assets" },
        { "binding": "PUBLIC_APP_ASSETS", "bucket_name": "dev-r2-esposter-public-app-assets" },
        { "binding": "PUBLIC_DUNGEONS_ASSETS", "bucket_name": "dev-r2-esposter-public-dungeons-assets" },
        { "binding": "PUBLIC_GENSHIN_ASSETS", "bucket_name": "dev-r2-esposter-public-genshin-assets" },
        { "binding": "PUBLIC_USER_ASSETS", "bucket_name": "dev-r2-esposter-public-user-assets" },
        { "binding": "RESOURCE_ASSETS", "bucket_name": "dev-r2-esposter-resource-assets" },
        { "binding": "USER_ASSETS", "bucket_name": "dev-r2-esposter-user-assets" },
      ],
      "durable_objects": {
        "bindings": [
          { "name": "SCHEDULER", "class_name": "Scheduler" },
          { "name": "CALL", "class_name": "CallObject" },
          { "name": "ROOM", "class_name": "RoomObject" },
          { "name": "USER", "class_name": "UserObject" },
        ],
      },
      "migrations": [
        { "tag": "v1", "new_sqlite_classes": ["Scheduler"] },
        { "tag": "v2", "new_sqlite_classes": ["CallObject", "RoomObject", "UserObject"] },
      ],
    },
  },
}
