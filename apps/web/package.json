{
  "name": "@esposter/web",
  "version": "4.10.0",
  "private": true,
  "description": "An approachable, performant and versatile javascript application powered by Vue.",
  "homepage": "https://github.com/Esposter/Esposter#readme",
  "bugs": {
    "url": "https://github.com/Esposter/Esposter/issues"
