  "author": "Jimmy Chen",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Esposter/Esposter.git"
  },
  "type": "module",
  "exports": {
    "./package.json": "./package.json"
  },
  "scripts": {
    "ai:unocss:generate": "vpx --tsconfig tsconfig.root.json scripts/unocss/index.ts",
    "analyze": "nuxt analyze",
    "bench": "vitest bench --run",
    "build": "nuxt build",
    "cleanup": "nuxt cleanup",
    "dev": "vp run -w build:packages && pnpm --filter @esposter/db-schema db:migrate && nuxt dev --no-tui",
    "flow-map:gen": "vpx --tsconfig tsconfig.root.json scripts/flowMap/index.ts",
    "generate": "nuxt generate",
    "generate-pwa-assets": "pnpm dlx pwa-asset-generator https://prodstesposter001.blob.core.windows.net/esposter-assets/logo.png public/pwa -o false -f",
    "lint": "TIMING=1 eslint .",
    "lint:fix": "TIMING=1 eslint --fix .",
    "phaser:gen": "vpx --tsconfig tsconfig.root.json scripts/phaser/index.ts",
    "postinstall": "nuxt prepare",
    "preview": "nuxt preview",
    "pwsh": "pwsh -ExecutionPolicy Unrestricted",
    "start": "node --env-file-if-exists=.env .output/server/index.mjs",
    "test": "vitest",
    "tiled:gen": "vpx --tsconfig tsconfig.root.json scripts/tiled/index.ts",
    "typecheck": "nuxt prepare && tsrs -b --fast --runExternalCode",
    "zstd:gen": "vpx --tsconfig tsconfig.root.json scripts/zstd/index.ts"
  },
