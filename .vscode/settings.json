{
  "[javascript][typescript][vue]": {
    "editor.codeActionsOnSave": { "source.fixAll.oxc": "explicit", "source.organizeImports": "explicit" }
  },
  "[xml]": { "editor.formatOnSave": false },
  "debug.internalConsoleOptions": "neverOpen",
  "editor.defaultFormatter": "oxc.oxc-vscode",
  "editor.formatOnSave": true,
  "editor.gotoLocation.multipleDefinitions": "goto",
  "files.associations": { ".env": "env", ".env.example": "env", ".tsx": "xml" },
  // Keeps the file watcher (and therefore the language server's project reloads) out of generated trees.
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.nuxt/**": true,
    "**/.output/**": true,
    "**/dist/**": true,
    "**/node_modules/**": true
  },
  "js/ts.experimental.useTsgo": true,
  "js/ts.tsdk.path": "./node_modules/tsrs/tsdk",
  "js/ts.updateImportsOnFileMove.enabled": "always",
  "oxc.enable": true,
  "search.followSymlinks": false,
  // @TODO: https://github.com/ubugeeei-prod/vize/issues/13548 — the language server's config runtime opens a visible console window on Windows; the template lint still runs in `pnpm lint`
  "vize.lint.enable": false,
  "vize.typecheck.enable": false
}
