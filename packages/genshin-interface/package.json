{
  "name": "genshin-interface",
  "version": "4.8.0",
  "description": "Genshin Impact's interface as a fan recreation: the game's own screen units, face and pointer, and its buttons, dividers, bars and notices as presentational Vue components.",
  "keywords": [
    "component-library",
    "game-ui",
    "genshin-impact",
    "interface",
    "vue",
    "vue3"
  ],
  "homepage": "https://github.com/Esposter/Esposter/blob/main/packages/genshin-interface#readme",
  "bugs": {
    "url": "https://github.com/Esposter/Esposter/issues"
  },
  "license": "Apache-2.0",
  "author": "Jimmy Chen",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Esposter/Esposter.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "types": "dist/index.d.ts",
  "imports": {
    "#src/*": "./src/*.ts",
    "#src/*.vue": "./src/*.vue"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./constants": {
      "source": "./src/services/constants.ts",
      "default": "./dist/constants.js"
    },
    "./getFixtureImageName": {
      "source": "./src/services/getFixtureImageName.ts",
      "default": "./dist/getFixtureImageName.js"
    },
    "./save": {
      "source": "./src/save.ts",
      "default": "./dist/save.js"
    },
    "./package.json": "./package.json",
    "./style.css": "./dist/style.css",
    "./styles/confirmDialog.css": {
      "source": "./src/styles/confirmDialog.css",
      "default": "./dist/styles/confirmDialog.css"
    },
    "./styles/creamPill.css": {
      "source": "./src/styles/creamPill.css",
      "default": "./dist/styles/creamPill.css"
    },
    "./styles/creamPillButton.css": {
      "source": "./src/styles/creamPillButton.css",
      "default": "./dist/styles/creamPillButton.css"
    },
    "./styles/ringButton.css": {
      "source": "./src/styles/ringButton.css",
      "default": "./dist/styles/ringButton.css"
    },
    "./styles/rowTint.css": {
      "source": "./src/styles/rowTint.css",
      "default": "./dist/styles/rowTint.css"
    },
    "./styles/shopScreen.css": {
      "source": "./src/styles/shopScreen.css",
      "default": "./dist/styles/shopScreen.css"
    }
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.js",
      "./constants": "./dist/constants.js",
      "./getFixtureImageName": "./dist/getFixtureImageName.js",
      "./save": "./dist/save.js",
      "./package.json": "./package.json",
      "./style.css": "./dist/style.css",
      "./styles/confirmDialog.css": "./dist/styles/confirmDialog.css",
      "./styles/creamPill.css": "./dist/styles/creamPill.css",
      "./styles/creamPillButton.css": "./dist/styles/creamPillButton.css",
      "./styles/ringButton.css": "./dist/styles/ringButton.css",
      "./styles/rowTint.css": "./dist/styles/rowTint.css",
      "./styles/shopScreen.css": "./dist/styles/shopScreen.css"
    },
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "test": "vitest",
    "test:visual": "vitest --config vitest.browser.config.ts",
    "typecheck": "tsrs --fast --runExternalCode"
  },
  "devDependencies": {
    "@esposter/configuration": "workspace:*",
    "@fontsource/signika": "catalog:",
    "@tsdown/css": "catalog:",
    "@types/node": "catalog:",
    "tsdown": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vitest-browser-vue": "catalog:"
  },
  "peerDependencies": {
    "vue": "catalog:"
  },
  "inlinedDependencies": {
    "vize": "0.717.0"
  }
}
