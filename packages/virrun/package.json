{
  "name": "virrun",
  "version": "2.39.0",
  "description": "An ephemeral, in-memory virtual runner that runs a repo's real toolchain fast and isolated.",
  "keywords": [
    "ci",
    "cli",
    "in-memory",
    "isolated",
    "monorepo",
    "runner",
    "sandbox",
    "testing",
    "toolchain",
    "typescript",
    "vfs",
    "virtual"
  ],
  "homepage": "https://github.com/Esposter/Esposter/blob/main/packages/virrun#readme",
  "bugs": {
    "url": "https://github.com/Esposter/Esposter/issues"
  },
  "license": "Apache-2.0",
  "author": "Jimmy Chen",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Esposter/Esposter.git"
  },
  "bin": {
    "virrun": "bin/cli.js"
  },
  "files": [
    "bin",
    "dist",
    "schema.json"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "dist/index.d.ts",
  "imports": {
    "#src/*": "./src/*.ts"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./cli": {
      "source": "./src/cli.ts",
      "default": "./dist/cli.js"
    },
    "./config": {
      "source": "./src/services/configuration/defineConfig.ts",
      "default": "./dist/config.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.js",
      "./cli": "./dist/cli.js",
      "./config": "./dist/config.js",
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "bench": "vitest bench --run",
    "build": "tsdown",
    "export:gen": "generate-exports",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "test": "vitest",
    "typecheck": "tsc"
  },
  "dependencies": {
    "unconfig": "catalog:"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "catalog:",
    "@esposter/configuration": "workspace:*",
    "@esposter/shared": "workspace:*",
    "@esposter/shared-node": "workspace:*",
    "@platformatic/vfs": "catalog:",
    "@types/node": "catalog:",
    "citty": "catalog:",
    "dedent": "catalog:",
    "fast-check": "catalog:",
    "publint": "catalog:",
    "tsdown": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  },
  "inlinedDependencies": {
    "@platformatic/vfs": "0.4.0",
    "citty": "0.2.2",
    "dedent": "1.7.2",
    "neverthrow": "8.2.0",
    "zod": "4.5.4"
  }
}
