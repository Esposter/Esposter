{
  "name": "nuxt-security-module",
  "version": "4.3.3",
  "description": "Nuxt security module for Nitro 3 and h3 2 — security headers, a per-request nonce Content Security Policy, subresource integrity, CORS, allowed methods, basic auth and a request size limit.",
  "license": "Apache-2.0",
  "author": "Jimmy Chen",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Esposter/Esposter.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "dist/index.d.ts",
  "imports": {
    "#src/*": "./src/*.ts"
  },
  "exports": {
    ".": {
      "source": "./src/module.ts",
      "default": "./dist/index.js"
    },
    "./runtime/nitro/plugins/routeRules": {
      "source": "./src/runtime/nitro/plugins/routeRules.ts",
      "default": "./dist/runtime/nitro/plugins/routeRules.js"
    },
    "./runtime/server/middleware/rateLimiter": {
      "source": "./src/runtime/server/middleware/rateLimiter.ts",
      "default": "./dist/runtime/server/middleware/rateLimiter.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.js",
      "./runtime/nitro/plugins/routeRules": "./dist/runtime/nitro/plugins/routeRules.js",
      "./runtime/server/middleware/rateLimiter": "./dist/runtime/server/middleware/rateLimiter.js",
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "tsdown",
    "bench": "vitest bench --run",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "test": "vitest",
    "typecheck": "tsrs --fast"
  },
  "dependencies": {
    "@nuxt/kit": "catalog:",
    "@nuxt/schema": "catalog:",
    "defu": "catalog:",
    "rou3": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@esposter/configuration": "workspace:*",
    "@esposter/shared-node": "workspace:*",
    "@nuxt/nitro-server": "catalog:",
    "@types/node": "catalog:",
    "h3": "catalog:",
    "tsdown": "catalog:"
  },
  "peerDependencies": {
    "nitro": "catalog:",
    "nuxt": "catalog:"
  }
}
