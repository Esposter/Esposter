{
  "name": "genshin-text",
  "version": "3.8.1",
  "description": "Genshin Impact's own text in its fifteen languages: the language registry, a matcher from a browser's locale, and the game's strings looked up by the game's own text id, one lazily loaded chunk per language.",
  "keywords": [
    "genshin",
    "genshin-impact",
    "i18n",
    "localization",
    "textmap",
    "translation",
    "typescript"
  ],
  "homepage": "https://github.com/Esposter/Esposter/blob/main/packages/genshin-text#readme",
  "bugs": {
    "url": "https://github.com/Esposter/Esposter/issues"
  },
  "license": "Apache-2.0",
  "author": "Jimmy Chen",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Esposter/Esposter.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "dist/index.d.ts",
  "imports": {
    "#src/*": "./src/*.ts",
    "#src/*.json": "./src/*.json"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.js",
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "test": "vitest",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@esposter/shared": "workspace:*"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "catalog:",
    "@esposter/configuration": "workspace:*",
    "publint": "catalog:",
    "tsdown": "catalog:",
    "vitest": "catalog:"
  }
}
