{
  "name": "@esposter/infra",
  "version": "2.38.0",
  "private": true,
  "description": "Pulumi infrastructure code for Esposter Azure resources.",
  "keywords": [
    "azure",
    "azure-native",
    "cloud",
    "deployment",
    "devops",
    "iac",
    "infrastructure",
    "pulumi",
    "ts",
    "typescript"
  ],
  "homepage": "https://github.com/Esposter/Esposter/blob/main/packages/infra#readme",
  "bugs": {
    "url": "https://github.com/Esposter/Esposter/issues"
  },
  "license": "Apache-2.0",
  "author": "Jimmy Chen",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Esposter/Esposter.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.js",
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "pnpm export:gen && tsdown",
    "export:gen": "ctix build --config ../configuration/.ctirc-ts",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "infra:preview": "pnpm build && pulumi preview",
    "infra:refresh": "pnpm build && pulumi refresh",
    "infra:up": "pnpm build && pulumi up",
    "test": "vitest",
    "typecheck": "tsgo"
  },
  "dependencies": {
    "@esposter/db-schema": "workspace:*",
    "@esposter/shared": "workspace:*"
  },
  "devDependencies": {
    "@esposter/configuration": "workspace:*",
    "@types/node": "catalog:",
    "ctix": "catalog:",
    "tsdown": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@pulumi/azure-native": "catalog:",
    "@pulumi/github": "catalog:",
    "@pulumi/pulumi": "catalog:"
  },
  "inlinedDependencies": {
    "dayjs": "1.11.23",
    "deepmerge": "4.3.1",
    "dom-serializer": "3.1.1",
    "domelementtype": "3.0.0",
    "domhandler": "6.0.1",
    "domutils": "4.0.2",
    "drizzle-orm": "1.0.0-rc.4",
    "entities": "8.0.0",
    "escape-string-regexp": "4.0.0",
    "htmlparser2": "12.0.0",
    "is-plain-object": "5.1.0",
    "launder": "1.7.1",
    "nanoid": "3.3.18",
    "neverthrow": "8.2.0",
    "parse-srcset": "1.0.2",
    "picocolors": "1.1.1",
    "postcss": "8.5.26",
    "sanitize-html": "2.17.7",
    "source-map-js": "1.2.1",
    "zod": "4.4.3"
  }
}
