{
  "name": "trpc-msw",
  "version": "4.4.0",
  "description": "tRPC for Mock Service Worker — answers queries, mutations and subscriptions over HTTP, batching, SSE and WebSockets with tRPC's own handlers, typed off your router.",
  "keywords": [
    "batch",
    "mock",
    "msw",
    "sse",
    "subscriptions",
    "testing",
    "trpc",
    "typescript",
    "websocket"
  ],
  "homepage": "https://github.com/Esposter/Esposter/blob/main/packages/trpc-msw#readme",
  "bugs": {
    "url": "https://github.com/Esposter/Esposter/issues"
  },
  "license": "Apache-2.0",
  "author": "Jimmy Chen",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Esposter/Esposter.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "dist/index.d.ts",
  "imports": {
    "#src/*": "./src/*.ts"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.js",
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "test": "vitest",
    "typecheck": "tsrs --fast"
  },
  "dependencies": {
    "@esposter/shared": "workspace:*"
  },
  "devDependencies": {
    "@esposter/configuration": "workspace:*",
    "@standard-schema/spec": "catalog:",
    "@trpc/client": "catalog:",
    "@types/node": "catalog:",
    "superjson": "catalog:",
    "trpc-nuxt-module": "workspace:*",
    "tsdown": "catalog:",
    "type-fest": "catalog:",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "@trpc/server": "catalog:",
    "msw": "catalog:"
  },
  "inlinedDependencies": {
    "type-fest": "5.10.0"
  }
}
