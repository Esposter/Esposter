{
  "name": "genshin-mods",
  "version": "3.9.0",
  "description": "A Claude Code plugin of five mods under one band above the prompt: the next steps, the cache and usage with a one-click handoff, recording mode, a goal's task list and a question before editing a file another session just changed.",
  "keywords": [
    "claude-code",
    "claude-code-plugin",
    "genshin",
    "mods"
  ],
  "homepage": "https://esposter.com/docs/infra/claude-interface/genshin-mods",
  "bugs": {
    "url": "https://github.com/Esposter/Esposter/issues"
  },
  "license": "Apache-2.0",
  "author": "Jimmy Chen",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Esposter/Esposter.git"
  },
  "files": [
    ".claude-plugin",
    "hooks",
    "src",
    "types",
    "!**/*.test.ts",
    "!.claude-plugin/types"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "test": "vitest",
    "validate": "claude plugin validate ."
  }
}
