{
  "name": "unplugin-pwa-nuxt",
  "version": "4.8.0",
  "description": "Nuxt PWA module on unplugin-pwa — a service worker built by the app, its manifest and its client plugin, for Nuxt 5 and Nitro 3 only",
  "keywords": [
    "nuxt",
    "nuxt-module",
    "offline",
    "pwa",
    "service-worker",
    "vite",
    "web-app-manifest",
    "workbox"
  ],
  "homepage": "https://github.com/Esposter/Esposter/blob/main/packages/unplugin-pwa-nuxt#readme",
  "bugs": {
    "url": "https://github.com/Esposter/Esposter/issues"
  },
  "license": "Apache-2.0",
  "author": "Jimmy Chen",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Esposter/Esposter.git"
  },
  "files": [
    "dist",
    "navigation-denylist.d.ts"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "dist/index.d.ts",
  "imports": {
    "#src/*": "./src/*.ts"
  },
  "exports": {
    ".": {
      "source": "./src/module.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./navigation-denylist": {
      "types": "./navigation-denylist.d.ts"
    }
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.js",
      "./package.json": "./package.json",
      "./navigation-denylist": {
        "types": "./navigation-denylist.d.ts"
      }
    },
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "test": "vitest",
    "typecheck": "tsrs --fast"
  },
  "dependencies": {
    "@esposter/shared": "workspace:*",
    "@nuxt/kit": "catalog:",
    "@nuxt/schema": "catalog:",
    "@unplugin-pwa/core": "catalog:",
    "@unplugin-pwa/vite": "catalog:",
    "@vite-pwa/workbox-build": "catalog:"
  },
  "devDependencies": {
    "@esposter/configuration": "workspace:*",
    "@esposter/shared-node": "workspace:*",
    "@nuxt/nitro-server": "catalog:",
    "@types/node": "catalog:",
    "@vite-pwa/workbox-swkit": "catalog:",
    "@vite-pwa/workbox-window": "catalog:",
    "tsdown": "catalog:",
    "vite": "catalog:"
  },
  "peerDependencies": {
    "nitro": "catalog:",
    "nuxt": "catalog:",
    "vue": "catalog:"
  }
}
