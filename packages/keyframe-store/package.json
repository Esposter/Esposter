{
  "name": "keyframe-store",
  "version": "3.0.0",
  "description": "Content-addressed version storage — every version is a zstd keyframe or a delta against one, over any backend that can store bytes by key.",
  "keywords": [
    "compression",
    "content-addressed",
    "deduplication",
    "delta",
    "history",
    "keyframe",
    "node",
    "storage",
    "typescript",
    "version",
    "zstd"
  ],
  "homepage": "https://github.com/Esposter/Esposter/blob/main/packages/keyframe-store#readme",
  "bugs": {
    "url": "https://github.com/Esposter/Esposter/issues"
  },
  "license": "Apache-2.0",
  "author": "Jimmy Chen",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Esposter/Esposter.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "dist/index.d.ts",
  "imports": {
    "#src/*": "./src/*.ts"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.js",
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "bench": "vitest bench --run",
    "build": "tsdown",
    "export:gen": "generate-exports",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "test": "vitest",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@esposter/shared": "workspace:*",
    "neverthrow": "catalog:"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "catalog:",
    "@esposter/configuration": "workspace:*",
    "@esposter/shared-node": "workspace:*",
    "@types/node": "catalog:",
    "publint": "catalog:",
    "tsdown": "catalog:",
    "vitest": "catalog:"
  }
}
