{
  "name": "vue-grid-layout-headless",
  "version": "4.4.0",
  "description": "A headless grid: the placement of items on a grid of cells, and the pointer gestures that move and resize them, with no styling.",
  "keywords": [
    "dashboard",
    "grid",
    "headless",
    "layout",
    "typescript",
    "vue"
  ],
  "homepage": "https://github.com/Esposter/Esposter/blob/main/packages/vue-grid-layout-headless#readme",
  "bugs": {
    "url": "https://github.com/Esposter/Esposter/issues"
  },
  "license": "Apache-2.0",
  "author": "Jimmy Chen",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Esposter/Esposter.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "dist/index.d.ts",
  "imports": {
    "#src/*": "./src/*.ts"
  },
  "exports": {
    ".": {
      "source": "./src/vueGridLayoutHeadless.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.js",
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "test": "vitest",
    "typecheck": "tsrs --fast"
  },
  "dependencies": {
    "@esposter/shared": "workspace:*"
  },
  "devDependencies": {
    "@esposter/configuration": "workspace:*",
    "@vue/test-utils": "catalog:",
    "happy-dom": "catalog:",
    "tsdown": "catalog:"
  },
  "peerDependencies": {
    "vue": "catalog:"
  }
}
