{
  "name": "@esposter/azure-functions",
  "version": "2.38.1",
  "private": true,
  "description": "A library that contains webhook functionality.",
  "keywords": [
    "azure",
    "azure-functions",
    "cron",
    "drizzle-orm",
    "eventgrid",
    "push-notifications",
    "serverless",
    "timers",
    "typescript",
    "web-push",
    "webhook"
