{
  "name": "trpc-nuxt-module",
  "version": "3.5.1",
  "description": "tRPC for Nuxt — a Nuxt module that registers your router's HTTP and WebSocket handlers, fetches through the request event during SSR, and decorates the typed client with useQuery, useMutation and useSubscription over useAsyncData.",
  "keywords": [
    "nitro",
    "nuxt",
    "nuxt-module",
    "ssr",
    "subscriptions",
    "trpc",
    "typescript",
    "websocket"
  ],
  "homepage": "https://github.com/Esposter/Esposter/blob/main/packages/trpc-nuxt-module#readme",
  "bugs": {
    "url": "https://github.com/Esposter/Esposter/issues"
  },
  "license": "Apache-2.0",
  "author": "Jimmy Chen",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Esposter/Esposter.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "dist/index.d.ts",
  "imports": {
    "#src/*": "./src/*.ts"
  },
  "exports": {
