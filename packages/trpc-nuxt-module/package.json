{
  "name": "trpc-nuxt-module",
  "version": "4.4.0",
  "description": "tRPC for Nuxt — a Nuxt module that registers your router's HTTP and WebSocket handlers, fetches through the request event during SSR, and decorates the typed client with useQuery, useMutation and useSubscription over useAsyncData.",
  "keywords": [
    "nitro",
    "nuxt",
    "nuxt-module",
    "ssr",
    "subscriptions",
    "trpc",
    "typescript",
    "websocket"
  ],
  "homepage": "https://github.com/Esposter/Esposter/blob/main/packages/trpc-nuxt-module#readme",
  "bugs": {
    "url": "https://github.com/Esposter/Esposter/issues"
  },
  "license": "Apache-2.0",
  "author": "Jimmy Chen",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Esposter/Esposter.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "dist/index.d.ts",
  "imports": {
    "#src/*": "./src/*.ts"
  },
  "exports": {
    ".": {
      "source": "./src/module.ts",
      "default": "./dist/index.js"
    },
    "./runtime/client/createTRPCNuxtClient": {
      "source": "./src/runtime/client/createTRPCNuxtClient.ts",
      "default": "./dist/runtime/client/createTRPCNuxtClient.js"
    },
    "./runtime/client/getMutationKey": {
      "source": "./src/runtime/client/getMutationKey.ts",
      "default": "./dist/runtime/client/getMutationKey.js"
    },
    "./runtime/client/getQueryKey": {
      "source": "./src/runtime/client/getQueryKey.ts",
      "default": "./dist/runtime/client/getQueryKey.js"
    },
    "./runtime/client/httpBatchLink": {
      "source": "./src/runtime/client/httpBatchLink.ts",
      "default": "./dist/runtime/client/httpBatchLink.js"
    },
    "./runtime/client/httpLink": {
      "source": "./src/runtime/client/httpLink.ts",
      "default": "./dist/runtime/client/httpLink.js"
    },
    "./runtime/constants": {
      "source": "./src/runtime/constants.ts",
      "default": "./dist/runtime/constants.js"
    },
    "./runtime/server/createTRPCEventHandler": {
      "source": "./src/runtime/server/createTRPCEventHandler.ts",
      "default": "./dist/runtime/server/createTRPCEventHandler.js"
    },
    "./runtime/server/createTRPCWebSocketHandler": {
      "source": "./src/runtime/server/createTRPCWebSocketHandler.ts",
      "default": "./dist/runtime/server/createTRPCWebSocketHandler.js"
    },
    "./runtime/server/models/TRPCWebSocketConnection": {
      "source": "./src/runtime/server/models/TRPCWebSocketConnection.ts",
      "default": "./dist/runtime/server/models/TRPCWebSocketConnection.js"
    },
    "./runtime/server/models/WebSocketServerAdapter": {
      "source": "./src/runtime/server/models/WebSocketServerAdapter.ts",
      "default": "./dist/runtime/server/models/WebSocketServerAdapter.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.js",
      "./runtime/client/createTRPCNuxtClient": "./dist/runtime/client/createTRPCNuxtClient.js",
      "./runtime/client/getMutationKey": "./dist/runtime/client/getMutationKey.js",
      "./runtime/client/getQueryKey": "./dist/runtime/client/getQueryKey.js",
      "./runtime/client/httpBatchLink": "./dist/runtime/client/httpBatchLink.js",
      "./runtime/client/httpLink": "./dist/runtime/client/httpLink.js",
      "./runtime/constants": "./dist/runtime/constants.js",
      "./runtime/server/createTRPCEventHandler": "./dist/runtime/server/createTRPCEventHandler.js",
      "./runtime/server/createTRPCWebSocketHandler": "./dist/runtime/server/createTRPCWebSocketHandler.js",
      "./runtime/server/models/TRPCWebSocketConnection": "./dist/runtime/server/models/TRPCWebSocketConnection.js",
      "./runtime/server/models/WebSocketServerAdapter": "./dist/runtime/server/models/WebSocketServerAdapter.js",
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "bench": "vitest bench --run",
    "build": "tsdown",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "test": "vitest",
    "typecheck": "tsrs --fast"
  },
  "dependencies": {
    "@esposter/shared": "workspace:*",
    "@nuxt/kit": "catalog:",
    "@nuxt/schema": "catalog:",
    "ohash": "catalog:",
    "type-fest": "catalog:"
  },
  "devDependencies": {
    "@esposter/configuration": "workspace:*",
    "@esposter/shared-node": "workspace:*",
    "@nuxt/nitro-server": "catalog:",
    "@nuxt/test-utils": "catalog:",
    "@types/node": "catalog:",
    "happy-dom": "catalog:",
    "superjson": "catalog:",
    "tsdown": "catalog:",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "@trpc/client": "catalog:",
    "@trpc/server": "catalog:",
    "crossws": "catalog:",
    "nitro": "catalog:",
    "nuxt": "catalog:",
    "vue": "catalog:"
  }
}
