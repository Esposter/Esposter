{
  "name": "parse-tmx",
  "version": "2.39.0",
  "description": "A parser for tmx.",
  "keywords": [
    "game-development",
    "gamedev",
    "map",
    "parser",
    "phaser",
    "tiled",
    "tiled-map-editor",
    "tilemap",
    "tmx",
    "typescript",
    "xml"
  ],
  "homepage": "https://github.com/Esposter/Esposter/blob/main/packages/parse-tmx#readme",
  "bugs": {
    "url": "https://github.com/Esposter/Esposter/issues"
  },
  "license": "Apache-2.0",
  "author": "Jimmy Chen",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Esposter/Esposter.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "dist/index.d.ts",
  "imports": {
    "#src/*": "./src/*.ts"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.js",
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "export:gen": "generate-exports",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "test": "vitest",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@esposter/shared": "workspace:*",
    "@esposter/xml2js": "workspace:*",
    "data-urls": "catalog:"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "catalog:",
    "@esposter/configuration": "workspace:*",
    "@types/data-urls": "catalog:",
    "@types/xml2js": "catalog:",
    "publint": "catalog:",
    "tsdown": "catalog:",
    "type-fest": "catalog:",
    "vitest": "catalog:"
  }
}
