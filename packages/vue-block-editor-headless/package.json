{
  "name": "vue-block-editor-headless",
  "version": "4.6.0",
  "description": "A headless Vue block editor: a typed node tree over a registry, the commands that edit it as JSON Patch operations, navigation and undo history, and an editing-session composable, with no styling or DOM.",
  "keywords": [
    "headless",
    "typescript",
    "vue"
  ],
  "homepage": "https://github.com/Esposter/Esposter/blob/main/packages/vue-block-editor-headless#readme",
  "bugs": {
    "url": "https://github.com/Esposter/Esposter/issues"
  },
  "license": "Apache-2.0",
  "author": "Jimmy Chen",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Esposter/Esposter.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "dist/index.d.ts",
  "imports": {
    "#src/*": "./src/*.ts"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.js",
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "test": "vitest",
    "typecheck": "tsrs --fast"
  },
  "dependencies": {
    "@esposter/shared": "workspace:*",
    "neverthrow": "catalog:"
  },
  "devDependencies": {
    "@esposter/configuration": "workspace:*",
    "tsdown": "catalog:"
  },
  "peerDependencies": {
    "vue": "catalog:",
    "zod": "catalog:"
  }
}
