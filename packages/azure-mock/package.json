{
  "name": "azure-mock",
  "version": "4.4.0",
  "description": "A library that contains azure mock classes.",
  "keywords": [
    "azure",
    "azure-storage",
    "blob-storage",
    "data-tables",
    "eventgrid",
    "mock",
    "search",
    "service-bus",
    "storage-queue",
    "table-storage",
    "testing",
    "typescript",
    "web-pubsub"
  ],
  "homepage": "https://github.com/Esposter/Esposter#readme",
  "bugs": {
    "url": "https://github.com/Esposter/Esposter/issues"
  },
  "license": "Apache-2.0",
  "author": "Jimmy Chen",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Esposter/Esposter.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "dist/index.d.ts",
  "imports": {
    "#src/*": "./src/*.ts"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.js",
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "test": "vitest",
    "typecheck": "tsrs --fast"
  },
  "dependencies": {
    "@esposter/azure": "workspace:*",
    "@esposter/shared": "workspace:*"
  },
  "devDependencies": {
    "@esposter/configuration": "workspace:*",
    "tsdown": "catalog:",
    "type-fest": "catalog:"
  },
  "peerDependencies": {
    "@azure/core-http-compat": "catalog:",
    "@azure/core-rest-pipeline": "catalog:",
    "@azure/data-tables": "catalog:",
    "@azure/eventgrid": "catalog:",
    "@azure/search-documents": "catalog:",
    "@azure/service-bus": "catalog:",
    "@azure/storage-blob": "catalog:",
    "@azure/storage-queue": "catalog:"
  },
  "inlinedDependencies": {
    "type-fest": "5.10.0"
  }
}
