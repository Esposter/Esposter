{
  "name": "@esposter/xml2js",
  "version": "2.39.0",
  "description": "Simple XML to JavaScript object converter.",
  "keywords": [
    "converter",
    "json",
    "json-to-xml",
    "parser",
    "sax",
    "xml",
    "xml-parser",
    "xml-to-json",
    "xml2js",
    "xmlbuilder"
  ],
  "homepage": "https://github.com/Esposter/Esposter/blob/main/packages/xml2js#readme",
  "bugs": {
    "url": "https://github.com/Esposter/Esposter/issues"
  },
  "license": "Apache-2.0",
  "author": "Jimmy Chen",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Esposter/Esposter.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "dist/index.d.ts",
  "imports": {
    "#src/*": "./src/*.ts"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.js",
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "export:gen": "generate-exports",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "test": "vitest",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@esposter/shared": "workspace:*",
    "sax": "catalog:",
    "xmlbuilder2": "catalog:"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "catalog:",
    "@esposter/configuration": "workspace:*",
    "@types/sax": "catalog:",
    "@types/xml2js": "catalog:",
    "publint": "catalog:",
    "tsdown": "catalog:",
    "type-fest": "catalog:",
    "vitest": "catalog:"
  },
  "inlinedDependencies": {
    "@types/xml2js": "0.4.14",
    "type-fest": "5.9.0"
  }
}
