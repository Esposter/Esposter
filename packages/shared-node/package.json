{
  "name": "@esposter/shared-node",
  "version": "4.1.0",
  "description": "Node-only shared tooling: the machine-wide download cache, hidden-window child processes, and benchmark reporting reused across packages.",
  "keywords": [
    "benchmark",
    "child-process",
    "monorepo",
    "node",
    "reporting",
    "shared",
    "tooling",
    "typescript",
    "vitest",
    "windows"
  ],
  "homepage": "https://github.com/Esposter/Esposter/blob/main/packages/shared-node#readme",
  "bugs": {
    "url": "https://github.com/Esposter/Esposter/issues"
  },
  "license": "Apache-2.0",
  "author": "Jimmy Chen",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Esposter/Esposter.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#src/*": "./src/*.ts"
  },
  "exports": {
    "./bench": {
      "source": "./src/services/constants.ts",
      "default": "./dist/bench.js"
    },
    "./cache": {
      "source": "./src/cache.ts",
      "default": "./dist/cache.js"
    },
    "./child-process": {
      "source": "./src/childProcess.ts",
      "default": "./dist/child-process.js"
    },
    "./reporter": {
      "source": "./src/services/BenchmarkMarkdownReporter.ts",
      "default": "./dist/reporter.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      "./bench": "./dist/bench.js",
      "./cache": "./dist/cache.js",
      "./child-process": "./dist/child-process.js",
      "./reporter": "./dist/reporter.js",
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "test": "vitest",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@esposter/shared": "workspace:*"
  },
  "devDependencies": {
    "@esposter/configuration": "workspace:*",
    "@types/node": "catalog:",
    "tsdown": "catalog:"
  },
  "peerDependencies": {
    "vitest": "catalog:"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  }
}
