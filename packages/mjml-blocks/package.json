{
  "name": "mjml-blocks",
  "version": "4.4.0",
  "description": "MJML's components as block types on the headless block editor — each component's attributes, defaults and nesting rules, a render to MJML's JSON form and source, and a read back from MJML, with no framework, DOM or MJML runtime.",
  "keywords": [
    "typescript"
  ],
  "homepage": "https://github.com/Esposter/Esposter/blob/main/packages/mjml-blocks#readme",
  "bugs": {
    "url": "https://github.com/Esposter/Esposter/issues"
  },
  "license": "Apache-2.0",
  "author": "Jimmy Chen",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Esposter/Esposter.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "dist/index.d.ts",
  "imports": {
    "#src/*": "./src/*.ts"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.js",
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "bench": "vitest bench --run",
    "build": "tsdown",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "test": "vitest",
    "typecheck": "tsrs --fast"
  },
  "dependencies": {
    "@esposter/shared": "workspace:*",
    "headless-block-editor": "workspace:*",
    "node-html-parser": "catalog:"
  },
  "devDependencies": {
    "@esposter/configuration": "workspace:*",
    "@esposter/shared-node": "workspace:*",
    "@types/mjml": "catalog:",
    "mjml": "catalog:",
    "mjml-preset-core": "catalog:",
    "tsdown": "catalog:"
  },
  "peerDependencies": {
    "zod": "catalog:"
  }
}
