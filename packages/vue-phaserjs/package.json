{
  "name": "vue-phaserjs",
  "version": "2.39.0",
  "description": "A component library to integrate Phaser Framework with Vue.",
  "keywords": [
    "component-library",
    "game-development",
    "game-engine",
    "gamedev",
    "integration",
    "nuxt",
    "phaser",
    "phaser4",
    "pinia",
    "typescript",
    "vue",
    "vue3"
  ],
  "homepage": "https://github.com/Esposter/Esposter/blob/main/packages/vue-phaserjs#readme",
  "bugs": {
    "url": "https://github.com/Esposter/Esposter/issues"
  },
  "license": "Apache-2.0",
  "author": "Jimmy Chen",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Esposter/Esposter.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "dist/index.d.ts",
  "imports": {
    "#src/*": "./src/*.ts",
    "#src/*.vue": "./src/*.vue"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.js",
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "export:gen": "generate-exports vue",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "test": "vitest",
    "typecheck": "vue-tsc"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "catalog:",
    "@esposter/configuration": "workspace:*",
    "@vue/test-utils": "catalog:",
    "publint": "catalog:",
    "tsdown": "catalog:",
    "type-fest": "catalog:",
    "typedoc": "catalog:",
    "vitest": "catalog:",
    "vue-tsc": "catalog:"
  },
  "peerDependencies": {
    "@esposter/shared": "workspace:*",
    "parse-tmx": "workspace:*",
    "phaser": "catalog:",
    "phaser4-rex-plugins": "catalog:",
    "pinia": "catalog:",
    "vue": "catalog:"
  },
  "inlinedDependencies": {
    "type-fest": "5.9.0"
  }
}
