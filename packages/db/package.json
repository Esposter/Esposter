{
  "name": "@esposter/db",
  "version": "2.38.0",
  "private": true,
  "description": "A library of database utilities that is available in server environment only.",
  "keywords": [
    "azure",
    "blob-storage",
    "database",
    "drizzle",
    "drizzle-orm",
    "orm",
    "pg",
    "postgres",
    "postgresql",
    "schema",
    "sql",
    "table-storage",
    "ts",
    "typescript",
    "web-pubsub",
    "zod"
  ],
  "homepage": "https://github.com/Esposter/Esposter/blob/main/packages/db#readme",
  "bugs": {
    "url": "https://github.com/Esposter/Esposter/issues"
  },
  "license": "Apache-2.0",
  "author": "Jimmy Chen",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Esposter/Esposter.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "types": "dist/index.d.ts",
  "imports": {
    "#src/*": "./src/*.ts"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.js",
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "pnpm export:gen && tsdown",
    "export:gen": "ctix build --config ../configuration/.ctirc-ts",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "test": "vitest",
    "typecheck": "tsgo"
  },
  "dependencies": {
    "@esposter/shared": "workspace:*",
    "dayjs": "catalog:",
    "link-preview-js": "catalog:",
    "linkifyjs": "catalog:",
    "mime-types": "catalog:",
    "node-html-parser": "catalog:"
  },
  "devDependencies": {
    "@esposter/configuration": "workspace:*",
    "@esposter/db-mock": "workspace:*",
    "@types/mime-types": "catalog:",
    "ctix": "catalog:",
    "tsdown": "catalog:",
    "type-fest": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@azure/core-client": "catalog:",
    "@azure/core-rest-pipeline": "catalog:",
    "@azure/data-tables": "catalog:",
    "@azure/search-documents": "catalog:",
    "@azure/service-bus": "catalog:",
    "@azure/storage-blob": "catalog:",
    "@azure/storage-queue": "catalog:",
    "@azure/web-pubsub": "catalog:",
    "@esposter/azure": "workspace:*",
    "@esposter/db-schema": "workspace:*",
    "drizzle-orm": "catalog:"
  },
  "inlinedDependencies": {
    "type-fest": "5.8.0"
  }
}
