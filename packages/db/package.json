{
  "name": "@esposter/db",
  "version": "2.39.0",
  "private": true,
  "description": "A library of database utilities that is available in server environment only.",
  "keywords": [
    "azure",
    "blob-storage",
    "database",
    "drizzle",
    "drizzle-orm",
    "orm",
    "pg",
    "postgres",
    "postgresql",
    "schema",
    "sql",
    "table-storage",
    "ts",
    "typescript",
    "web-pubsub",
    "zod"
  ],
  "homepage": "https://github.com/Esposter/Esposter/blob/main/packages/db#readme",
  "bugs": {
    "url": "https://github.com/Esposter/Esposter/issues"
  },
  "license": "Apache-2.0",
  "author": "Jimmy Chen",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Esposter/Esposter.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "dist/index.d.ts",
  "imports": {
    "#src/*": "./src/*.ts"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.js",
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "tsdown",
    "export:gen": "generate-exports",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "test": "vitest",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@esposter/shared": "workspace:*",
    "link-preview-js": "catalog:",
    "linkifyjs": "catalog:",
    "mime-types": "catalog:",
    "node-html-parser": "catalog:"
  },
  "devDependencies": {
    "@esposter/configuration": "workspace:*",
    "@esposter/db-mock": "workspace:*",
    "@types/mime-types": "catalog:",
    "tsdown": "catalog:",
    "type-fest": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@azure/core-client": "catalog:",
    "@azure/core-rest-pipeline": "catalog:",
    "@azure/data-tables": "catalog:",
    "@azure/search-documents": "catalog:",
    "@azure/service-bus": "catalog:",
    "@azure/storage-blob": "catalog:",
    "@azure/storage-queue": "catalog:",
    "@azure/web-pubsub": "catalog:",
    "@esposter/azure": "workspace:*",
    "@esposter/db-schema": "workspace:*",
    "drizzle-orm": "catalog:"
  },
  "inlinedDependencies": {
    "boolbase": "1.0.0",
    "cheerio": "1.0.0-rc.11",
    "cheerio-select": "2.1.0",
    "css-select": "5.2.2",
    "css-what": "6.2.2",
    "dom-serializer": "2.0.0",
    "domelementtype": "2.3.0",
    "domhandler": "5.0.3",
    "domutils": "3.2.2",
    "entities": [
      "4.5.0",
      "6.0.1"
    ],
    "htmlparser2": "8.0.2",
    "link-preview-js": "5.0.0",
    "nth-check": "2.1.1",
    "parse5": "7.3.0",
    "parse5-htmlparser2-tree-adapter": "7.1.0",
    "undici": "8.10.1"
  }
}
