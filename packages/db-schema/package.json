{
  "name": "@esposter/db-schema",
  "version": "2.39.0",
  "private": true,
  "description": "A library of database schemas and utilities using Drizzle ORM (PostgreSQL) that is available in both browser and server environments.",
  "keywords": [
    "azure",
    "database",
    "drizzle",
    "drizzle-kit",
    "drizzle-orm",
    "migrations",
    "orm",
    "pg",
    "postgres",
    "postgresql",
    "schema",
    "sql",
    "ts",
    "typescript",
    "zod"
  ],
  "homepage": "https://github.com/Esposter/Esposter/blob/main/packages/db-schema#readme",
  "bugs": {
    "url": "https://github.com/Esposter/Esposter/issues"
  },
  "license": "Apache-2.0",
  "author": "Jimmy Chen",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Esposter/Esposter.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "dist/index.d.ts",
  "imports": {
    "#src/*": "./src/*.ts"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.js",
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "tsdown",
    "export:gen": "generate-exports",
    "db:gen": "pnpm db:run generate",
    "db:pull": "pnpm db:run pull",
    "db:run": "node node_modules/drizzle-kit/bin.cjs",
    "db:studio": "pnpm db:run studio",
    "db:up": "pnpm db:run up",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "test": "vitest",
    "typecheck": "tsc"
  },
  "dependencies": {},
  "devDependencies": {
    "@esposter/configuration": "workspace:*",
    "@trpc/server": "catalog:",
    "drizzle-kit": "catalog:",
    "tsdown": "catalog:",
    "type-fest": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@azure/data-tables": "catalog:",
    "@azure/eventgrid": "catalog:",
    "@azure/storage-blob": "catalog:",
    "@esposter/azure": "workspace:*",
    "@esposter/shared": "workspace:*",
    "drizzle-orm": "catalog:",
    "zod": "catalog:"
  }
}
