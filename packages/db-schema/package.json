{
  "name": "@esposter/db-schema",
  "version": "4.12.0",
  "private": true,
  "description": "A library of database schemas and utilities using Drizzle ORM for D1 and the Durable Objects' SQLite that is available in both browser and server environments.",
  "homepage": "https://github.com/Esposter/Esposter/blob/main/packages/db-schema#readme",
  "bugs": {
    "url": "https://github.com/Esposter/Esposter/issues"
  },
  "license": "Apache-2.0",
  "author": "Jimmy Chen",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Esposter/Esposter.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "dist/index.d.ts",
  "imports": {
    "#src/objects/call/migrations/*": "./src/objects/call/migrations/*",
    "#src/objects/room/migrations/*": "./src/objects/room/migrations/*",
    "#src/objects/user/migrations/*": "./src/objects/user/migrations/*",
    "#src/*": "./src/*.ts"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./objects/call/migrations/migrations": {
      "source": "./src/objects/call/migrations/migrations.js",
      "default": "./dist/objects/call/migrations/migrations.js"
    },
    "./objects/room/migrations/migrations": {
      "source": "./src/objects/room/migrations/migrations.js",
      "default": "./dist/objects/room/migrations/migrations.js"
    },
    "./objects/user/migrations/migrations": {
      "source": "./src/objects/user/migrations/migrations.js",
      "default": "./dist/objects/user/migrations/migrations.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.js",
      "./objects/call/migrations/migrations": "./dist/objects/call/migrations/migrations.js",
      "./objects/room/migrations/migrations": "./dist/objects/room/migrations/migrations.js",
      "./objects/user/migrations/migrations": "./dist/objects/user/migrations/migrations.js",
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "pnpm registry:gen && tsdown",
    "db:gen": "pnpm registry:gen && drizzle-kit generate && drizzle-kit generate --config drizzle.room.config.ts && drizzle-kit generate --config drizzle.call.config.ts && drizzle-kit generate --config drizzle.user.config.ts && node scripts/rewriteObjectMigrations.ts && pnpm -w exec vp fmt packages/db-schema/src/objects/call/migrations/migrations.js packages/db-schema/src/objects/room/migrations/migrations.js packages/db-schema/src/objects/user/migrations/migrations.js",
    "db:migrate": "node --env-file-if-exists=../../apps/web/.env node_modules/drizzle-kit/bin.cjs migrate",
    "db:pull": "drizzle-kit pull",
    "db:studio": "drizzle-kit studio",
    "db:up": "drizzle-kit up",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "registry:gen": "node scripts/generateRegistry.ts",
    "test": "vitest",
    "typecheck": "tsrs --fast"
  },
  "dependencies": {
    "uuid": "catalog:"
  },
  "devDependencies": {
    "@esposter/configuration": "workspace:*",
    "drizzle-kit": "catalog:",
    "tsdown": "catalog:",
    "type-fest": "catalog:"
  },
  "peerDependencies": {
    "@esposter/shared": "workspace:*",
    "drizzle-orm": "catalog:",
    "zod": "catalog:"
  },
  "scriptsComments": {
    "db:migrate": "@TODO: https://github.com/drizzle-team/drizzle-orm/pull/6543 — point at node_modules/drizzle-kit/bin.js once it is released"
  }
}
