{
  "name": "@esposter/db-mock",
  "version": "4.19.0",
  "private": true,
  "description": "A library of database mock utilities for testing and the dev seed, available in server environment only.",
  "homepage": "https://github.com/Esposter/Esposter/blob/main/packages/db-mock#readme",
  "bugs": {
    "url": "https://github.com/Esposter/Esposter/issues"
  },
  "license": "Apache-2.0",
  "author": "Jimmy Chen",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Esposter/Esposter.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "dist/index.d.ts",
  "imports": {
    "#src/*": "./src/*.ts"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./cache": {
      "source": "./src/services/createMockCache.ts",
      "default": "./dist/cache.js"
    },
    "./cloudflare-workers": {
      "source": "./src/cloudflareWorkers.ts",
      "default": "./dist/cloudflare-workers.js"
    },
    "./global-setup": {
      "source": "./src/globalSetup.ts",
      "default": "./dist/global-setup.js"
    },
    "./vitest": {
      "source": "./src/setupMockBucket.ts",
      "default": "./dist/vitest.js"
    },
    "./workers": {
      "source": "./src/workers/index.ts",
      "default": "./dist/workers.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.js",
      "./cache": "./dist/cache.js",
      "./cloudflare-workers": "./dist/cloudflare-workers.js",
      "./global-setup": "./dist/global-setup.js",
      "./vitest": "./dist/vitest.js",
      "./workers": "./dist/workers.js",
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest",
    "typecheck": "tsrs --fast"
  },
  "dependencies": {
    "@esposter/configuration": "workspace:*",
    "@esposter/shared": "workspace:*",
    "@esposter/shared-node": "workspace:*",
    "miniflare": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@types/node": "catalog:",
    "tsdown": "catalog:",
    "uuid": "catalog:"
  },
  "peerDependencies": {
    "@esposter/db-schema": "workspace:*",
    "drizzle-orm": "catalog:",
    "vitest": "catalog:"
  }
}
