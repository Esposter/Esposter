{
  "name": "@esposter/db-mock",
  "version": "4.10.1",
  "private": true,
  "description": "A library of database mock utilities for testing and the dev seed, available in server environment only.",
  "homepage": "https://github.com/Esposter/Esposter/blob/main/packages/db-mock#readme",
  "bugs": {
    "url": "https://github.com/Esposter/Esposter/issues"
  },
  "license": "Apache-2.0",
  "author": "Jimmy Chen",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Esposter/Esposter.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "dist/index.d.ts",
  "imports": {
    "#src/*": "./src/*.ts"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.js",
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "tsdown",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "test": "vitest",
    "typecheck": "tsrs --fast"
  },
  "dependencies": {
    "miniflare": "catalog:"
  },
  "devDependencies": {
    "@esposter/configuration": "workspace:*",
    "@types/node": "catalog:",
    "tsdown": "catalog:"
  },
  "peerDependencies": {
    "@esposter/db-schema": "workspace:*",
    "drizzle-orm": "catalog:"
  }
}
