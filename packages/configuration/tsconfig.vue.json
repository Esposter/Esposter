{
  "compilerOptions": {
    "allowArbitraryExtensions": true,
    "allowJs": true,
    "jsx": "preserve",
    "jsxImportSource": "vue",
    "lib": ["ESNext", "dom", "dom.iterable", "webworker"],
    "plugins": [
      {
        "name": "@dxup/unimport"
      },
      {
        "name": "@dxup/nuxt"
      }
    ]
  },
  "extends": "./tsconfig.base.json",
  "include": [
    "types/*.d.ts",
    "${configDir}/types/*.d.ts",
    "${configDir}/*.ts",
    "${configDir}/scripts/**/*.ts",
    "${configDir}/src/**/*.ts",
    "${configDir}/src/**/*.vue"
  ]
}
