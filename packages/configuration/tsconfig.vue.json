{
  "compilerOptions": {
    "allowArbitraryExtensions": true,
    "jsx": "preserve",
    "jsxImportSource": "vue",
    "lib": ["ESNext", "dom", "dom.iterable", "webworker"],
    "plugins": [{ "name": "@dxup/unimport" }, { "name": "@dxup/nuxt" }]
  },
  "contentMappers": [{ "package": "vize", "extensions": [".vue"], "options": { "optionsApi": false } }],
  "extends": "./tsconfig.base.json",
  "include": [
    "types/*.d.ts",
    "types/vue/*.d.ts",
    "${configDir}/types/*.d.ts",
    "${configDir}/*.ts",
    "${configDir}/scripts/**/*.ts",
    "${configDir}/src/**/*.ts",
    "${configDir}/src/**/*.vue"
  ],
  "vueCompilerOptions": {
    "checkUnknownComponents": true,
    "checkUnknownDirectives": true,
    "checkUnknownEvents": true,
    "checkUnknownProps": true,
    "composables": { "useTemplateRef": ["useTemplateRef"] },
    "fallthroughAttributes": true,
    "inferTemplateDollarAttrs": true,
    "inferTemplateDollarSlots": true,
    "strictTemplates": true,
    "strictVModel": true
  }
}
