{
  "name": "@esposter/configuration",
  "version": "2.38.0",
  "private": true,
  "description": "A library that contains shared configuration.",
  "keywords": [
    "build",
    "configuration",
    "ctix",
    "eslint",
    "formatting",
    "linting",
    "oxlint",
    "rolldown",
    "shared-config",
    "tsconfig",
    "typescript",
    "vite"
  ],
  "homepage": "https://github.com/Esposter/Esposter/blob/main/packages/configuration#readme",
  "bugs": {
    "url": "https://github.com/Esposter/Esposter/issues"
  },
  "license": "Apache-2.0",
  "author": "Jimmy Chen",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Esposter/Esposter.git"
  },
  "type": "module",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json",
    "./eslint/*": "./eslint/*"
  },
  "scripts": {
    "build": "pnpm export:gen && tsdown",
    "export:gen": "ctix build --config .ctirc-ts",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "test": "vitest",
    "typecheck": "tsgo"
  },
  "devDependencies": {
    "@dxup/nuxt": "catalog:",
    "@dxup/unimport": "catalog:",
    "@eslint/core": "catalog:",
    "@eslint/json": "catalog:",
    "@types/node": "catalog:",
    "@unocss/eslint-config": "catalog:",
    "@vue/language-core": "catalog:",
    "ctix": "catalog:",
    "eslint-plugin-depend": "catalog:",
    "eslint-plugin-oxlint": "catalog:",
    "eslint-plugin-perfectionist": "catalog:",
    "eslint-plugin-pinia": "catalog:",
    "eslint-plugin-vuejs-accessibility": "catalog:",
    "tsdown": "catalog:",
    "type-fest": "catalog:",
    "unplugin-auto-import": "catalog:",
    "unplugin-vue": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
