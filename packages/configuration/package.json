{
  "name": "@esposter/configuration",
  "version": "3.5.1",
  "private": true,
  "description": "A library that contains shared configuration.",
  "keywords": [
    "build",
    "configuration",
    "eslint",
    "formatting",
    "linting",
    "oxlint",
    "shared-config",
    "tsconfig",
    "tsdown",
    "typescript",
    "vite"
  ],
  "homepage": "https://github.com/Esposter/Esposter/blob/main/packages/configuration#readme",
  "bugs": {
    "url": "https://github.com/Esposter/Esposter/issues"
  },
  "license": "Apache-2.0",
  "author": "Jimmy Chen",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Esposter/Esposter.git"
  },
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#src/*": "./src/*.ts"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./eslint/*": "./eslint/*",
    "./types/*": "./types/*",
    "./vitest/*": "./vitest/*"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.js",
      "./package.json": "./package.json",
      "./eslint/*": "./eslint/*",
      "./types/*": "./types/*",
      "./vitest/*": "./vitest/*"
    }
  },
  "scripts": {
    "build": "tsdown",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "test": "vitest",
    "typecheck": "tsc"
  },
  "devDependencies": {
    "@dxup/nuxt": "catalog:",
    "@dxup/unimport": "catalog:",
    "@eslint/core": "catalog:",
    "@eslint/json": "catalog:",
    "@types/node": "catalog:",
    "@unocss/eslint-config": "catalog:",
    "eslint-plugin-depend": "catalog:",
    "eslint-plugin-jsonc": "catalog:",
    "eslint-plugin-oxlint": "catalog:",
    "eslint-plugin-perfectionist": "catalog:",
    "eslint-plugin-pinia": "catalog:",
    "eslint-plugin-vuejs-accessibility": "catalog:",
    "rolldown": "catalog:",
    "tsdown": "catalog:",
    "type-fest": "catalog:",
    "unplugin-auto-import": "catalog:",
    "unplugin-vue": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vue-eslint-parser": "catalog:"
  }
}
