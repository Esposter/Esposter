{
  "name": "@esposter/configuration",
  "version": "4.16.0",
  "private": true,
  "description": "A library that contains shared configuration.",
  "homepage": "https://github.com/Esposter/Esposter/blob/main/packages/configuration#readme",
  "bugs": {
    "url": "https://github.com/Esposter/Esposter/issues"
  },
  "license": "Apache-2.0",
  "author": "Jimmy Chen",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Esposter/Esposter.git"
  },
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#src/*": "./src/*.ts"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./constants": {
      "default": "./dist/constants.js",
      "source": "./src/services/constants.ts"
    },
    "./package.json": "./package.json",
    "./eslint/*": "./eslint/*",
    "./generate-barrels": "./src/services/generateBarrels.ts",
    "./generate-exports": "./src/services/generateExports.ts",
    "./oxfmt": "./oxfmt/oxfmtConfiguration.ts",
    "./read-exports-generation": "./src/services/readExportsGeneration.ts",
    "./types/global.d.ts": "./types/global.d.ts",
    "./vitest/*": "./vitest/*"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.js",
      "./constants": {
        "default": "./dist/constants.js",
        "source": "./src/services/constants.ts"
      },
      "./package.json": "./package.json",
      "./eslint/*": "./eslint/*",
      "./generate-barrels": "./src/services/generateBarrels.ts",
      "./generate-exports": "./src/services/generateExports.ts",
      "./oxfmt": "./oxfmt/oxfmtConfiguration.ts",
      "./read-exports-generation": "./src/services/readExportsGeneration.ts",
      "./types/global.d.ts": "./types/global.d.ts",
      "./vitest/*": "./vitest/*"
    }
  },
  "scripts": {
    "build": "tsdown",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "test": "vitest",
    "typecheck": "tsrs --fast"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "catalog:",
    "@dxup/nuxt": "catalog:",
    "@dxup/unimport": "catalog:",
    "@eslint/core": "catalog:",
    "@eslint/json": "catalog:",
    "@types/node": "catalog:",
    "@unocss/eslint-config": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "@vizejs/unplugin": "catalog:",
    "@vizejs/vite-plugin": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-depend": "catalog:",
    "eslint-plugin-jsonc": "catalog:",
    "eslint-plugin-oxlint": "catalog:",
    "eslint-plugin-perfectionist": "catalog:",
    "natural-orderby": "catalog:",
    "playwright": "catalog:",
    "publint": "catalog:",
    "rolldown": "catalog:",
    "tsdown": "catalog:",
    "type-fest": "catalog:",
    "unplugin-auto-import": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vue": "catalog:",
    "vue-eslint-parser": "catalog:",
    "zod": "catalog:"
  }
}
