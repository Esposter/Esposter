{
  "name": "survey-logic",
  "version": "4.4.0",
  "private": true,
  "description": "The survey's expression language — conditions, calculated values and validators over a survey's answers, held to parity with SurveyJS's recorded answers",
  "keywords": [
    "typescript"
  ],
  "homepage": "https://github.com/Esposter/Esposter/blob/main/packages/survey-logic#readme",
  "bugs": {
    "url": "https://github.com/Esposter/Esposter/issues"
  },
  "license": "Apache-2.0",
  "author": "Jimmy Chen",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Esposter/Esposter.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "dist/index.d.ts",
  "imports": {
    "#src/*": "./src/*.ts"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "test": "vitest",
    "typecheck": "tsrs --fast"
  },
  "dependencies": {
    "@esposter/shared": "workspace:*",
    "neverthrow": "catalog:"
  },
  "devDependencies": {
    "@esposter/configuration": "workspace:*",
    "tsdown": "catalog:"
  }
}
