{
  "name": "esposter",
  "version": "1.0.0",
  "description": "A nice and casual place for posting random things.",
  "keywords": [
    "azure",
    "chat",
    "drizzle-orm",
    "monorepo",
    "nuxt",
    "phaser",
    "pinia",
    "pnpm",
    "postgresql",
    "pwa",
    "realtime",
    "serverless",
    "social-platform",
    "trpc",
    "typescript",
    "unocss",
    "vite",
    "vue",
    "zod"
  ],
  "homepage": "https://github.com/Esposter/Esposter#readme",
  "bugs": {
    "url": "https://github.com/Esposter/Esposter/issues"
  },
  "license": "Apache-2.0",
  "author": "Jimmy Chen",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Esposter/Esposter.git"
  },
  "type": "module",
  "scripts": {
    "ai:ci:watch": "pnpm -C scripts ai:ci:watch",
    "ai:citations:sync": "pnpm -C scripts ai:citations:sync",
    "ai:dependencies:score": "pnpm -C scripts ai:dependencies:score",
    "ai:fleet:data": "pnpm -C scripts ai:fleet:data",
    "ai:fleet:claim": "pnpm -C scripts ai:fleet:claim",
    "ai:fleet:fill": "pnpm -C scripts ai:fleet:fill",
    "ai:fleet:hold": "pnpm -C scripts ai:fleet:hold",
    "ai:fleet:next": "pnpm -C scripts ai:fleet:next",
    "ai:fleet:profile": "pnpm -C scripts ai:fleet:profile",
    "ai:fleet:release": "pnpm -C scripts ai:fleet:release",
    "ai:fleet:status": "pnpm -C scripts ai:fleet:status",
    "ai:gcsim:configs": "pnpm -C scripts ai:gcsim:configs",
    "ai:identifiers:rename": "pnpm -C scripts ai:identifiers:rename",
    "ai:machine:watch": "pnpm -C scripts ai:machine:watch",
    "ai:package:new": "pnpm -C scripts ai:package:new",
    "ai:proposals:report": "pnpm -C scripts ai:proposals:report",
    "ai:resume": "pnpm -C scripts ai:resume",
    "ai:review": "pnpm -C scripts ai:review",
    "ai:review:fix": "pnpm -C scripts ai:review:fix",
    "ai:review:settle": "pnpm -C scripts ai:review:settle",
    "ai:skills:extract": "pnpm -C scripts ai:skills:extract",
    "ai:sweep:constant-scope": "pnpm -C scripts ai:sweep:constant-scope",
    "ai:sweep:duplicate-code": "pnpm -C scripts ai:sweep:duplicate-code",
    "ai:sweep:duplicate-prose": "pnpm -C scripts ai:sweep:duplicate-prose",
    "ai:sweep:file-organization": "pnpm -C scripts ai:sweep:file-organization",
    "ai:sweep:ledger-coverage": "pnpm -C scripts ai:sweep:ledger-coverage",
    "ai:sweep:repeated-list-items": "pnpm -C scripts ai:sweep:repeated-list-items",
    "ai:sweep:shared-export-consumers": "pnpm -C scripts ai:sweep:shared-export-consumers",
    "ai:sweep:skill-docs": "pnpm -C scripts ai:sweep:skill-docs",
    "ai:sweep:unterminated-results": "pnpm -C scripts ai:sweep:unterminated-results",
    "ai:triage:label": "pnpm -C scripts ai:triage:label",
    "ai:usage": "pnpm -C scripts ai:usage",
    "ai:unocss:generate": "pnpm -C apps/web ai:unocss:generate",
    "ai:voice-match": "pnpm -C scripts ai:voice-match",
    "bench": "pnpm -r --workspace-concurrency=1 --if-present bench",
    "bench:ci": "vitest bench --run",
    "bench:types": "pnpm -C scripts bench:types",
    "build": "pnpm --filter \"@esposter/web...\" build",
    "build:docs": "typedoc",
    "coverage": "vitest run --coverage",
    "crossOS": "pnpm -C scripts crossOS",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "graph:gen": "pnpm -C scripts graph:gen",
    "lint:eslint": "eslint .",
    "lint:fix:eslint": "eslint --fix .",
    "lint:fix:oxlint": "vp lint --debug=timings --format=default --fix --disable-nested-config",
    "lint:fix:packages:oxlint": "vp lint --debug=timings --format=default --fix --disable-nested-config packages",
    "lint:fix:packages:workspace": "pnpm -r --filter \"./packages/*\" --parallel lint:fix",
    "lint:fix:workspace": "pnpm -r --parallel lint:fix",
    "lint:oxlint": "vp lint --debug=timings --format=default --disable-nested-config",
    "lint:packages:oxlint": "vp lint --debug=timings --format=default --disable-nested-config packages",
    "lint:packages:workspace": "pnpm -r --filter \"./packages/*\" --parallel lint",
    "lint:unused": "knip",
    "lint:workflows": "actionlint -shellcheck= -pyflakes=",
    "lint:workspace": "pnpm -r --parallel lint",
    "outdated:dependencies": "pnpm -C scripts outdated:dependencies",
    "prepare": "git config core.hooksPath .githooks || true",
    "pwsh": "pwsh -ExecutionPolicy Unrestricted",
    "recreation": "pnpm -C scripts recreation",
    "refresh:lockfile": "pnpm crossOS refresh:lockfile",
    "release": "pnpm format:check && vp run build:packages && vp run lint:packages && pnpm typecheck:packages && pnpm test:packages && lerna publish from-package --yes",
    "release:version": "lerna version --yes --no-push",
    "start": "pnpm -C apps/web start",
    "test": "vitest run",
    "test:packages": "vitest run --project \"packages/*\"",
    "typecheck:packages": "pnpm -r --filter \"./packages/*\" --parallel typecheck",
    "typecheck:root": "tsc",
    "typecheck:workspace": "pnpm -r --parallel typecheck",
    "update:node": "pnpm -C scripts update:node"
  },
  "devDependencies": {
    "@esposter/configuration": "workspace:*",
    "@esposter/shared-node": "workspace:*",
    "@kjanat/actionlint": "catalog:",
    "@lerna-lite/cli": "catalog:",
    "@lerna-lite/publish": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "knip": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typedoc": "catalog:",
    "typescript": "catalog:",
    "virrun": "workspace:*",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "packageManager": "pnpm@12.11.2+sha512.25a51652a196785af5f28bda6dfe8dc582ebefa4ac1d180221ce1390231c5fb76637822ea4b6e4633ce74acdcb0a77f725af11bad38177fdeddaee818a955cb9",
  "crossOS": {
    "refresh:lockfile": {
      "darwin": "sh ./scripts/src/refreshLockfile/index.sh",
      "linux": "./scripts/src/refreshLockfile/index.sh",
      "win32": "pnpm pwsh scripts/src/refreshLockfile/index.ps1"
    }
  },
  "scriptsComments": {
    "build": "@TODO: https://github.com/TypeStrong/typedoc/issues/3098 — restore `pnpm build:docs` to the chain once TypeDoc runs on TypeScript 7, or a bridge build grows the AST navigation API. TypeDoc exits 6 against the `typescript-native-bridge` alias, and `build` is what deploy runs, so the deploy would fail on documentation alone. `build:docs` stays as the probe. See the `build-docs` job in .github/workflows/CI.yaml."
  }
}
