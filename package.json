{
  "name": "esposter",
  "version": "1.0.0",
  "description": "A nice and casual place for posting random things.",
  "keywords": [
    "azure",
    "chat",
    "drizzle-orm",
    "monorepo",
    "nuxt",
    "phaser",
    "pinia",
    "pnpm",
    "postgresql",
    "pwa",
    "realtime",
    "serverless",
    "social-platform",
    "trpc",
    "typescript",
    "unocss",
    "vite",
    "vue",
    "vuetify",
    "zod"
  ],
  "homepage": "https://github.com/Esposter/Esposter#readme",
  "bugs": {
    "url": "https://github.com/Esposter/Esposter/issues"
  },
  "license": "Apache-2.0",
  "author": "Jimmy Chen",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Esposter/Esposter.git"
  },
  "type": "module",
  "scripts": {
    "ai:coderabbit:exclusions": "pnpm -C scripts run ai:coderabbit:exclusions",
    "ai:coderabbit:feedback": "pnpm -C scripts run ai:coderabbit:feedback",
    "ai:coderabbit:probe": "pnpm -C scripts run ai:coderabbit:probe",
    "ai:coderabbit:window": "pnpm -C scripts run ai:coderabbit:window",
    "ai:sweep:constant-scope": "pnpm -C scripts run ai:sweep:constant-scope",
    "ai:sweep:repeated-list-items": "pnpm -C scripts run ai:sweep:repeated-list-items",
    "ai:sweep:shared-export-consumers": "pnpm -C scripts run ai:sweep:shared-export-consumers",
    "ai:sweep:skill-docs": "pnpm -C scripts run ai:sweep:skill-docs",
    "ai:sweep:unterminated-results": "pnpm -C scripts run ai:sweep:unterminated-results",
    "bench": "pnpm -r --workspace-concurrency=1 --if-present run bench",
    "bench:ci": "vitest bench --run",
    "build": "pnpm --filter \"@esposter/web...\" run build",
    "build:docs": "virrun -- typedoc",
    "build:packages": "pnpm -r --filter \"./packages/*\" run build",
    "coverage": "vitest run --coverage",
    "crossOS": "pnpm -C scripts run crossOS",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "graph:gen": "pnpm -C scripts run graph:gen",
    "lint": "virrun -- oxlint --format=default --disable-nested-config && virrun -- eslint . && virrun -- pnpm -r --parallel run lint",
    "lint:fix": "virrun -- oxlint --format=default --fix --disable-nested-config && virrun -- eslint --fix . && virrun -- pnpm -r --parallel run lint:fix",
    "lint:fix:packages": "virrun -- oxlint --format=default --fix --disable-nested-config packages && virrun -- pnpm -r --filter \"./packages/*\" --parallel run lint:fix",
    "lint:packages": "virrun -- oxlint --format=default --disable-nested-config packages && virrun -- pnpm -r --filter \"./packages/*\" --parallel run lint",
    "outdated:dependencies": "pnpm -C scripts run outdated:dependencies",
    "prepare": "git config core.hooksPath .githooks || true",
    "pwsh": "pwsh -ExecutionPolicy Unrestricted",
    "refresh:lockfile": "pnpm crossOS refresh:lockfile",
    "release": "pnpm format:check && pnpm build:packages && pnpm lint:packages && pnpm typecheck:packages && pnpm test:packages && lerna publish --yes",
    "start": "pnpm -C apps/web run start",
    "test": "virrun -- vitest run",
    "test:packages": "virrun -- vitest run --project \"packages/*\"",
    "typecheck": "virrun -- tsc && virrun -- pnpm -r --parallel run typecheck",
    "typecheck:packages": "virrun -- pnpm -r --filter \"./packages/*\" --parallel run typecheck",
    "update:node": "pnpm -C scripts run update:node",
    "watch:packages": "pnpm -r --filter \"./packages/*\" --parallel exec tsdown --watch"
  },
  "devDependencies": {
    "@esposter/configuration": "workspace:*",
    "@esposter/shared-node": "workspace:*",
    "@lerna-lite/cli": "catalog:",
    "@lerna-lite/publish": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "dotenv": "catalog:",
    "eslint": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typedoc": "catalog:",
    "typescript": "catalog:",
    "virrun": "workspace:*",
    "vitest": "catalog:"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^26.8.2",
      "onFail": "warn"
    }
  },
  "engines": {
    "node": "^26.8.2"
  },
  "packageManager": "pnpm@12.3.4+sha512.961aa41fb077da3a04a441d9f8e15ebc0c96da8ef710b2eb67bf9ee7cb0610eabd48f1fd85f51cffe73846785fa0f87c56a3a872a1d893f8446741b5cce45457",
  "crossOS": {
    "refresh:lockfile": {
      "darwin": "sh ./scripts/src/refreshLockfile/index.sh",
      "linux": "./scripts/src/refreshLockfile/index.sh",
      "win32": "pnpm pwsh scripts/src/refreshLockfile/index.ps1"
    },
    "update:node": {
      "darwin": "sh ./scripts/src/updateNode/install.sh",
      "linux": "./scripts/src/updateNode/install.sh",
      "win32": "pnpm pwsh scripts/src/updateNode/install.ps1"
    }
  },
  "scriptsComments": {
    "build": "@TODO: restore `pnpm build:docs` to the chain when a bridge build grows the AST navigation API. TypeDoc exits 6 against the `typescript-native-bridge` alias, and `build` is what deploy runs, so the deploy would fail on documentation alone. `build:docs` stays as the probe. See the `build-docs` job in .github/workflows/CI.yaml."
  }
}
