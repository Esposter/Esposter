{
  "name": "esposter",
  "version": "1.0.0",
  "description": "A nice and casual place for posting random things.",
  "keywords": [
    "azure",
    "chat",
    "drizzle-orm",
    "monorepo",
    "nuxt",
    "phaser",
    "pinia",
    "pnpm",
    "postgresql",
    "pwa",
    "realtime",
    "serverless",
    "social-platform",
    "trpc",
    "typescript",
    "unocss",
    "vite",
    "vue",
    "vuetify",
    "zod"
  ],
  "homepage": "https://github.com/Esposter/Esposter#readme",
  "bugs": {
    "url": "https://github.com/Esposter/Esposter/issues"
  },
  "license": "Apache-2.0",
  "author": "Jimmy Chen",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Esposter/Esposter.git"
  },
  "type": "module",
  "scripts": {
    "bench": "vitest bench --run --project scripts && pnpm -r --if-present run bench",
    "build": "pnpm build:packages && pnpm build:docs && pnpm build:app",
    "build:app": "virrun -- pnpm --filter @esposter/app run build",
    "build:docs": "virrun -- typedoc",
    "build:packages": "pnpm -r --filter \"!@esposter/app\" run build",
    "coverage": "vitest run --coverage",
    "crossOS": "node scripts/crossOS.ts",
    "depcruise:graph": "virrun -- depcruise packages/*/src/index.ts --include-only \"^packages\" --collapse 2 --output-type dot | graphviz -Tsvg > dependency-graph.svg",
    "format": "virrun -- oxfmt",
    "format:check": "virrun -- oxfmt --check",
    "lint": "oxlint --format=default --disable-nested-config && eslint . && pnpm -r --parallel --aggregate-output run lint",
    "lint:fix": "oxlint --format=default --fix --disable-nested-config && eslint --fix . && pnpm -r --parallel --aggregate-output run lint:fix",
    "lint:fix:packages": "oxlint --format=default --fix --disable-nested-config --ignore-pattern \"packages/app/**\" packages && pnpm -r --filter \"!@esposter/app\" --parallel --aggregate-output run lint:fix",
    "lint:packages": "oxlint --format=default --disable-nested-config --ignore-pattern \"packages/app/**\" packages && pnpm -r --filter \"!@esposter/app\" --parallel --aggregate-output run lint",
    "outdated:dependencies": "tsx scripts/checkDependencies/index.ts",
    "prepare": "git config core.hooksPath .githooks || true",
    "pwsh": "pwsh -ExecutionPolicy Unrestricted",
    "refresh:lockfile": "pnpm crossOS refresh:lockfile",
    "release": "pnpm build:packages && pnpm lint:fix:packages && pnpm format && pnpm typecheck:packages && lerna publish --yes",
    "start": "pnpm --filter @esposter/app run start",
    "update:node": "tsx scripts/updateNode/index.ts",
    "test": "virrun -- vitest run",
    "test:packages": "virrun -- vitest run --project \"!@esposter/app\"",
    "typecheck": "virrun -- tsgo && virrun -- pnpm -r --parallel --aggregate-output run typecheck",
    "typecheck:packages": "virrun -- pnpm -r --filter \"!@esposter/app\" --parallel --aggregate-output run typecheck",
    "watch:packages": "pnpm -r --filter \"!@esposter/app\" --parallel --stream --if-present run watch"
  },
  "devDependencies": {
    "@esposter/configuration": "workspace:*",
    "@esposter/shared": "workspace:*",
    "@esposter/shared-node": "workspace:*",
    "@lerna-lite/cli": "catalog:",
    "@lerna-lite/publish": "catalog:",
    "@oxlint/plugins": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native-preview": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "dependency-cruiser": "catalog:",
    "dotenv": "catalog:",
    "eslint": "catalog:",
    "graphviz-cli": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "tsx": "catalog:",
    "typedoc": "catalog:",
    "typescript": "catalog:",
    "virrun": "workspace:*",
    "vitest": "catalog:"
  },
  "engines": {
    "node": "^26.5.0"
  },
  "packageManager": "pnpm@11.15.1+sha512.81350b07e53c9538a02f1f2303b4290fa2d7be04e56e2a970c4cc4b417dc761de196edabd49d55c7dc9580db81007c44143e4e3d7e462b3000d23c255122d065",
  "crossOS": {
    "refresh:lockfile": {
      "darwin": "sh ./scripts/refreshLockfile.sh",
      "linux": "./scripts/refreshLockfile.sh",
      "win32": "pnpm pwsh scripts/refreshLockfile.ps1"
    },
    "update:node": {
      "darwin": "sh ./scripts/updateNode/install.sh",
      "linux": "./scripts/updateNode/install.sh",
      "win32": "pnpm pwsh scripts/updateNode/install.ps1"
    }
  }
}
