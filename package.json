{
  "name": "esposter",
  "version": "1.0.0",
  "description": "A nice and casual place for posting random things.",
  "keywords": [
    "azure",
    "chat",
    "drizzle-orm",
    "monorepo",
    "nuxt",
    "phaser",
    "pinia",
    "pnpm",
    "postgresql",
    "pwa",
    "realtime",
    "serverless",
    "social-platform",
    "trpc",
    "typescript",
    "unocss",
    "vite",
    "vue",
    "vuetify",
    "zod"
  ],
  "homepage": "https://github.com/Esposter/Esposter#readme",
  "bugs": {
    "url": "https://github.com/Esposter/Esposter/issues"
  },
  "license": "Apache-2.0",
  "author": "Jimmy Chen",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Esposter/Esposter.git"
  },
  "type": "module",
  "imports": {
    "#scripts/*": "./scripts/*.ts"
  },
  "scripts": {
    "bench": "vitest bench --run --project scripts && pnpm -r --if-present run bench",
    "build": "pnpm build:packages && pnpm build:app",
    "build:app": "virrun -- pnpm --filter @esposter/app run build",
    "build:docs": "virrun -- typedoc",
    "build:packages": "pnpm -r --filter \"!@esposter/app\" run build",
    "coverage": "vitest run --coverage",
    "crossOS": "tsx scripts/crossOS.ts",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "graph:gen": "tsx scripts/dependencyGraph/index.ts",
    "lint": "virrun -- oxlint --format=default --disable-nested-config && virrun -- eslint . && virrun -- pnpm -r --parallel run lint",
    "lint:fix": "virrun -- oxlint --format=default --fix --disable-nested-config && virrun -- eslint --fix . && virrun -- pnpm -r --parallel run lint:fix",
    "lint:fix:packages": "virrun -- oxlint --format=default --fix --disable-nested-config --ignore-pattern \"packages/app/**\" packages && virrun -- pnpm -r --filter \"!@esposter/app\" --parallel run lint:fix",
    "lint:packages": "virrun -- oxlint --format=default --disable-nested-config --ignore-pattern \"packages/app/**\" packages && virrun -- pnpm -r --filter \"!@esposter/app\" --parallel run lint",
    "outdated:dependencies": "tsx scripts/outdatedDependencies/index.ts",
    "prepare": "git config core.hooksPath .githooks || true",
    "pwsh": "pwsh -ExecutionPolicy Unrestricted",
    "refresh:lockfile": "pnpm crossOS refresh:lockfile",
    "release": "pnpm format:check && pnpm build:packages && pnpm lint:packages && pnpm typecheck:packages && pnpm test:packages && lerna publish --yes",
    "start": "pnpm --filter @esposter/app run start",
    "sweep:constant-scope": "tsx scripts/sweeps/constantScope/index.ts",
    "sweep:repeated-list-items": "tsx scripts/sweeps/repeatedListItems/index.ts",
    "sweep:shared-export-consumers": "tsx scripts/sweeps/sharedExportConsumers/index.ts",
    "sweep:skill-docs": "tsx scripts/sweeps/skillDocs/index.ts",
    "sweep:unterminated-results": "tsx scripts/sweeps/unterminatedResults/index.ts",
    "test": "virrun -- vitest run",
    "test:packages": "virrun -- vitest run --project \"!@esposter/app\"",
    "typecheck": "virrun -- tsc && virrun -- pnpm -r --parallel run typecheck",
    "typecheck:packages": "virrun -- pnpm -r --filter \"!@esposter/app\" --parallel run typecheck",
    "update:node": "tsx scripts/updateNode/index.ts",
    "watch:packages": "pnpm -r --filter \"!@esposter/app\" --parallel exec tsdown --watch"
  },
  "devDependencies": {
    "@esposter/configuration": "workspace:*",
    "@esposter/shared": "workspace:*",
    "@esposter/shared-node": "workspace:*",
    "@hpcc-js/wasm-graphviz": "catalog:",
    "@lerna-lite/cli": "catalog:",
    "@lerna-lite/publish": "catalog:",
    "@oxlint/plugins": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "dotenv": "catalog:",
    "eslint": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "tsx": "catalog:",
    "typedoc": "catalog:",
    "typescript": "catalog:",
    "virrun": "workspace:*",
    "vitest": "catalog:"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^26.8.1",
      "onFail": "warn"
    }
  },
  "engines": {
    "node": "^26.8.1"
  },
  "packageManager": "pnpm@12.1.0+sha512.d9b8276d97f6ec86e49815877f91ee9f63cee61f2063b304e43b6dab8fa07ce8a9afd46d2facd39f921e6a9d06b3c75a81349c7b888c2d22886bae0229901037",
  "crossOS": {
    "refresh:lockfile": {
      "darwin": "sh ./scripts/refreshLockfile/index.sh",
      "linux": "./scripts/refreshLockfile/index.sh",
      "win32": "pnpm pwsh scripts/refreshLockfile/index.ps1"
    },
    "update:node": {
      "darwin": "sh ./scripts/updateNode/install.sh",
      "linux": "./scripts/updateNode/install.sh",
      "win32": "pnpm pwsh scripts/updateNode/install.ps1"
    }
  },
  "scriptsComments": {
    "build": "@TODO: restore `pnpm build:docs` to the chain when a bridge build grows the AST navigation API. TypeDoc exits 6 against the `typescript-native-bridge` alias, and `build` is what deploy runs, so the deploy would fail on documentation alone. `build:docs` stays as the probe. See the `build-docs` job in .github/workflows/CI.yaml."
  }
}
