{
  "name": "esposter",
  "version": "1.0.0",
  "description": "A nice and casual place for posting random things.",
  "keywords": [
    "azure",
    "chat",
    "drizzle-orm",
    "monorepo",
    "nuxt",
    "phaser",
    "pinia",
    "pnpm",
    "postgresql",
    "pwa",
    "realtime",
    "serverless",
    "social-platform",
    "trpc",
    "typescript",
    "unocss",
    "vite",
    "vue",
    "zod"
  ],
  "homepage": "https://github.com/Esposter/Esposter#readme",
  "bugs": {
    "url": "https://github.com/Esposter/Esposter/issues"
  },
  "license": "Apache-2.0",
  "author": "Jimmy Chen",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Esposter/Esposter.git"
  },
  "type": "module",
  "scripts": {
    "ai:citations:sync": "pnpm -C scripts ai:citations:sync",
    "ai:coderabbit:collect": "pnpm -C scripts ai:coderabbit:collect",
    "ai:coderabbit:feedback": "pnpm -C scripts ai:coderabbit:feedback",
    "ai:skills:extract": "pnpm -C scripts ai:skills:extract",
    "ai:sweep:constant-scope": "pnpm -C scripts ai:sweep:constant-scope",
    "ai:sweep:duplicate-prose": "pnpm -C scripts ai:sweep:duplicate-prose",
    "ai:sweep:file-organization": "pnpm -C scripts ai:sweep:file-organization",
    "ai:sweep:ledger-coverage": "pnpm -C scripts ai:sweep:ledger-coverage",
    "ai:sweep:repeated-list-items": "pnpm -C scripts ai:sweep:repeated-list-items",
    "ai:sweep:shared-export-consumers": "pnpm -C scripts ai:sweep:shared-export-consumers",
    "ai:sweep:skill-docs": "pnpm -C scripts ai:sweep:skill-docs",
    "ai:sweep:unterminated-results": "pnpm -C scripts ai:sweep:unterminated-results",
    "ai:triage:label": "pnpm -C scripts ai:triage:label",
    "ai:voice-match": "pnpm -C scripts ai:voice-match",
    "bench": "pnpm -r --workspace-concurrency=1 --if-present bench",
    "bench:ci": "vitest bench --run",
    "build": "pnpm --filter \"@esposter/web...\" build",
    "build:docs": "virrun -- typedoc",
    "build:packages": "pnpm -r --filter \"./packages/*\" --bail build",
    "coverage": "vitest run --coverage",
    "crossOS": "pnpm -C scripts crossOS",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "graph:gen": "pnpm -C scripts graph:gen",
    "lint": "run-s --continue-on-error lint:oxlint lint:eslint lint:workspace lint:unused",
    "lint:eslint": "virrun -- eslint .",
    "lint:fix": "run-s --continue-on-error lint:fix:oxlint lint:fix:eslint lint:fix:workspace",
    "lint:fix:eslint": "virrun -- eslint --fix .",
    "lint:fix:oxlint": "virrun -- oxlint --format=default --fix --disable-nested-config",
    "lint:fix:workspace": "virrun -- pnpm -r --parallel lint:fix",
    "lint:fix:packages": "run-s --continue-on-error lint:fix:packages:oxlint lint:fix:packages:workspace",
    "lint:fix:packages:oxlint": "virrun -- oxlint --format=default --fix --disable-nested-config packages",
    "lint:fix:packages:workspace": "virrun -- pnpm -r --filter \"./packages/*\" --parallel lint:fix",
    "lint:oxlint": "virrun -- oxlint --format=default --disable-nested-config",
    "lint:unused": "knip",
    "lint:packages": "run-s --continue-on-error lint:packages:oxlint lint:packages:workspace",
    "lint:packages:oxlint": "virrun -- oxlint --format=default --disable-nested-config packages",
    "lint:packages:workspace": "virrun -- pnpm -r --filter \"./packages/*\" --parallel lint",
    "lint:workspace": "virrun -- pnpm -r --parallel lint",
    "outdated:dependencies": "pnpm -C scripts outdated:dependencies",
    "prepare": "git config core.hooksPath .githooks || true",
    "pwsh": "pwsh -ExecutionPolicy Unrestricted",
    "refresh:lockfile": "pnpm crossOS refresh:lockfile",
    "release": "pnpm format:check && pnpm build:packages && pnpm lint:packages && pnpm typecheck:packages && pnpm test:packages && lerna publish --yes",
    "start": "pnpm -C apps/web start",
    "test": "virrun -- vitest run",
    "test:packages": "virrun -- vitest run --project \"packages/*\"",
    "typecheck": "run-s --continue-on-error typecheck:root typecheck:workspace",
    "typecheck:root": "virrun -- tsc",
    "typecheck:workspace": "virrun -- pnpm -r --parallel typecheck",
    "typecheck:packages": "virrun -- pnpm -r --filter \"./packages/*\" --parallel typecheck",
    "update:node": "pnpm -C scripts update:node",
    "watch:packages": "pnpm -r --filter \"./packages/*\" --parallel exec tsdown --watch"
  },
  "devDependencies": {
    "@esposter/configuration": "workspace:*",
    "@esposter/shared-node": "workspace:*",
    "@lerna-lite/cli": "catalog:",
    "@lerna-lite/publish": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "dotenv": "catalog:",
    "eslint": "catalog:",
    "knip": "catalog:",
    "npm-run-all2": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typedoc": "catalog:",
    "typescript": "catalog:",
    "virrun": "workspace:*",
    "vitest": "catalog:"
  },
  "packageManager": "pnpm@12.6.0+sha512.3ef68f951cb111ac204b4a5a16f0b2ddf0da56a96e0413e81d855d9f0b55ef926714709028e1cd00c405c2c5fb7b9e8ec4dc46777c805d0373c2f2ff00fd20ec",
  "crossOS": {
    "refresh:lockfile": {
      "darwin": "sh ./scripts/src/refreshLockfile/index.sh",
      "linux": "./scripts/src/refreshLockfile/index.sh",
      "win32": "pnpm pwsh scripts/src/refreshLockfile/index.ps1"
    },
    "update:node": {
      "darwin": "sh ./scripts/src/updateNode/install.sh",
      "linux": "./scripts/src/updateNode/install.sh",
      "win32": "pnpm pwsh scripts/src/updateNode/install.ps1"
    }
  },
  "scriptsComments": {
    "build": "@TODO: https://github.com/TypeStrong/typedoc/issues/3098 — restore `pnpm build:docs` to the chain once TypeDoc runs on TypeScript 7, or a bridge build grows the AST navigation API. TypeDoc exits 6 against the `typescript-native-bridge` alias, and `build` is what deploy runs, so the deploy would fail on documentation alone. `build:docs` stays as the probe. See the `build-docs` job in .github/workflows/CI.yaml."
  }
}
