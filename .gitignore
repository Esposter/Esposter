# Dependencies
node_modules
.pnpm-store

# Build output
dist
# The agent console host's Windows single executable and the Claude Code binary beside it
dist-sea
*.tsbuildinfo
# Nuxt and Nitro
.output
.nuxt
.nitro
.cache
.data
# The production build of genshin-world's parity page, which `genshin:parity load` builds and serves
/packages/genshin-world/parity-build

# Testing
coverage
.vitest
vitest.config.*.timestamp*
# The program `pnpm bench:types` writes beside a type bench while it measures one case, removed after each run
*.typebench.program.ts

# Local env files
.env
.env.*
!.env.example

# Azurite's local blob, queue and table data, which `pnpm dev` keeps beside apps/web
.azurite

# Logs
logs
*.log

# Tiled
*.tiled-session

# Agent tree (`.claude` is a symlink alias to `.agents`, so it needs no entry of its own)
scheduled_tasks.lock
.agents/worktrees

# OS
.DS_Store
# A crashed MSYS bash (Git Bash) writes its stack trace into the working directory
*.stackdump
