# Dependencies
node_modules
.pnpm-store

# Build output
dist
# The package barrels a build writes, `src/index.ts` included; no package un-ignores one
**/src/index.ts
**/src/components/index.ts
*.tsbuildinfo
# Nuxt and Nitro
.output
.nuxt
.nitro
.cache
.data
# Wrangler's local state and the deploy pointer Nitro writes beside the app
.wrangler
# The production build of genshin-world's parity page, which `genshin:parity load` builds and serves
/packages/genshin-world/parity-build

# Testing
coverage
.vitest
vitest.config.*.timestamp*
# The program `pnpm bench:types` writes beside a type bench while it measures one case, removed after each run
*.typebench.program.ts

# Local env files
.env
.env.*
!.env.example

# Logs
logs
*.log

# Tiled
*.tiled-session

# Agent tree (`.claude` is a symlink alias to `.agents`, so it needs no entry of its own)
scheduled_tasks.lock
.agents/worktrees
# pnpm writes this beside the dependency skills it links, listing only what that install linked, so a filtered
# worktree install rewrites it; each checkout keeps its own
.agents/skills/.gitignore

# OS
.DS_Store
# A crashed MSYS bash (Git Bash) writes its stack trace into the working directory
*.stackdump

# The dungeons game's key map, written at install from its committed lock, which the web app's prepare step regenerates
/apps/web/shared/generated/hostedAssetKeys/
